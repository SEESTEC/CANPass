+
+	priv->ctrl_handler.error = 0;
+
+	/* zoom, pan and tilt is not stable in latest bootdata */
+	switch (mcu_ctrl->ctrl_id) {
+//		case V4L2_CID_FRAME_SYNC:
+		case V4L2_CID_ZOOM_ABSOLUTE:
+		case V4L2_CID_PAN_ABSOLUTE:
