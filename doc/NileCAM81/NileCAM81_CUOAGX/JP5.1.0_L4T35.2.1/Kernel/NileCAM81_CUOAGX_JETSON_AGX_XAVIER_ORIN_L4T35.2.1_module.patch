diff --git a/NileCAM81_CUOAGX/pca9685.c b/NileCAM81_CUOAGX/pca9685.c
new file mode 100644
index 0000000..064f513
--- /dev/null
+++ b/NileCAM81_CUOAGX/pca9685.c
@@ -0,0 +1,489 @@
+/*
+ * pca9685.c - pca9685 support driver
+* Copyright (c) 2015-2016, e-con Systems.  All rights reserved.
+ *
