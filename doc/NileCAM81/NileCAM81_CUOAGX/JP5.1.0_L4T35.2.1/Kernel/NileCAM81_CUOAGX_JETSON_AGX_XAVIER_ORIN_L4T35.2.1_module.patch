+int mcu_bload_ascii2hex(unsigned char ascii)
+{
+	if (ascii <= '9') {
+		return (ascii - '0');
+	} else if ((ascii >= 'a') && (ascii <= 'f')) {
+		return (0xA + (ascii - 'a'));
+	} else if ((ascii >= 'A') && (ascii <= 'F')) {
+		return (0xA + (ascii - 'A'));
+	}
+	return -1;
+}
