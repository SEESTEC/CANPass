+/*
+ * This function gets the e-con specific data from DT
+ */
+int8_t	ecam_specific_dt_parse(struct i2c_client *client, struct cam *priv)
+{
+	uint32_t mipi_lane = 0, mipi_clk = 0;
+	int8_t errcode = ERRCODE_SUCCESS;
+	const char *str;
+	struct device_node *node = client->dev.of_node;
+	struct device_node *ser_node;
+	struct device_node *dser_node;
+	struct i2c_client *ser_i2c = NULL;
+	struct i2c_client *dser_i2c = NULL;
+
+	errcode = of_property_read_u32(node, "camera_mipi_lanes", &mipi_lane);
+        if (errcode < ERRCODE_SUCCESS) {
+                dev_err(&client->dev, "Can not get Camera MIPI Lanes\n");
+                goto error;
+        }
+	priv->mipi_lane_config = mipi_lane;
+
+	errcode = of_property_read_u32(node, "camera-mipi-clk", &mipi_clk);
+	if (errcode) {
+		dev_err(&client->dev, 
+			"camera mipi clk is missing or invalid\n");
+		goto error;
+	}
+	priv->mipi_clk_config = mipi_clk;
+
+	errcode = of_property_read_string(node, "mcu_fw_name",&mcu_fw_name);
+        if(!errcode){
+                pr_info("Firmware name from the device tree is > %s\n",
+                                			mcu_fw_name);
+	}
+        else{
+                pr_info("Unable to get mcu firmware name form Device tree\n");
+		goto error;
+	}
+
+	if(priv->cam_id == ISX031)
+	{	
+		/* ISX031 has ISP Bootdata */
+		errcode = of_property_read_string(node, "spi_mcu_fw_name",&mcu_fw_name_ISP);
+       		if(!errcode){
+        	        pr_info("ISP Firmware name from the device tree is > %s\n",
+                                			mcu_fw_name_ISP);
+		}
+       		else{
+               		pr_info("Unable to get mcu firmware name form Device tree\n");
+			goto error;
+		}
+		
+		/* Handled 60 fps in ISX031 */
+		errcode = of_property_read_string(node, "des-chip", &str);
+		if(!errcode){
+
+			if(!strcmp(str, "D1")){
+				priv->chip_des = 1;
+			}
+
+			if(!strcmp(str, "D2")){
+				priv->chip_des = 2;
+			}
+		}
+
+	}
+
+	errcode = of_property_read_string(node, "dev_name",&dev_name_comp[total_num_cam]);
+	if (!errcode)
+		pr_info("Dev_Name from the Device tree is %s\n",
+	                        dev_name_comp[total_num_cam]);
+	else{
+		pr_info("Unable to get Dev name form Device tree\n");
+		goto error;
+	}
+	
+	/*Identifying Deserializer SIO port for 
+	 * I2C Address Reassignment and Translation
+	 */
+	errcode = of_property_read_string(node, "sio-port", &str);
+	if (!errcode) {
+		if (!strcmp(str, "A")){
+			priv->phy = PHY_A;
+			pr_info("Current SIO ports is %c\n",priv->phy);
+			/* RESET status if PHYA */
+			ser_status = MAX96712_EN_LINK_NONE;
+		}
+		else if(!strcmp(str, "B")){
+		      	priv->phy = PHY_B;
+                      	pr_info("Current SIO ports is %c\n",priv->phy);
+               	}
+               	else if(!strcmp(str, "C")){
+                       	priv->phy = PHY_C;
+                       	pr_info("Current SIO ports is %c\n",priv->phy);
+               	}
+		else if(!strcmp(str, "D")){
+			priv->phy = PHY_D;
+			pr_info("Current SIO ports is %c\n",priv->phy);
+		}
+		else{
+			dev_err(&client->dev,"Invalid SIO Port");
+			errcode = -EINVAL;
+			goto error;
+		}	
+	} else {
+		dev_err(&client->dev,
+			"No SIO port mentioned in device tree\n");
+		goto error;
+	}
+
+	/* read SER properties from DT */ 
+	ser_node = of_parse_phandle(node, "nvidia,gmsl-ser-device", 0);
+	if (ser_node == NULL) {
+		dev_err(&client->dev,
+			"missing %s handle\n",
+				"nvidia,gmsl-ser-device");
+		errcode = -EINVAL;
+		goto error;
+	}
+	errcode = of_property_read_u32(ser_node, "reg", &priv->ser_reassigned_addr);
+	if (errcode < 0) {
+		dev_err(&client->dev, "serializer reg not found\n");
+		goto error;
+	}
+	pr_info("priv->ser_reassigned_addr = %x",priv->ser_reassigned_addr);
+	errcode = of_property_read_u32(ser_node, "def-addr", &priv->ser_def_addr);
+	if (errcode < 0) {
+		dev_err(&client->dev, "serializer def-addr not found in DTB\n");
+		goto error;
+	}
+
+	errcode = of_property_read_u32(ser_node, "reset_reg", &priv->reset_reg);
+	if (errcode < 0) {
+		dev_err(&client->dev, "serializer reset_reg not found in DTB\n");
+		goto error;
+	}
+
+	errcode = of_property_read_u32(ser_node, "boot_reg", &priv->boot_reg);
+	if (errcode < 0) {
+		dev_err(&client->dev, "serializer boot_reg not found in DTB\n");
+		goto error;
+	}
+#if 0
+	ser_i2c = of_find_i2c_device_by_node(ser_node);
+	of_node_put(ser_node);
+
+	if (ser_i2c == NULL) {
+		errcode = -EINVAL;
+		goto error;
+	}
+	if (ser_i2c->dev.driver == NULL) {
+		dev_err(&client->dev, "missing serializer driver\n");
+		errcode = -EIO;
+		goto error;
+	}
+
+	priv->ser_dev = &ser_i2c->dev;
+#endif
+	/* read DSER properties from DT */ 
+	dser_node = of_parse_phandle(node, "nvidia,gmsl-dser-device", 0);
+	if (dser_node == NULL) {
+		dev_err(&client->dev,
+			"missing %s handle\n",
+				"nvidia,gmsl-dser-device");
+		errcode = -EIO;
+		goto error;
+	}
+	errcode = of_property_read_u32(dser_node, "reg", &priv->dser_addr);
+	if (errcode < 0) {
+		dev_err(&client->dev, "Dserializer reg not found in DTB\n");
+		goto error;
+	}
+
+	errcode = of_property_read_u32(dser_node, "data-rate", &priv->dser_speed);
+	if (errcode < 0) {
+		dev_err(&client->dev, "Dserializer data_rate not found in DTB\n");
+		goto error;
+	}
+#if 0
+	dser_i2c = of_find_i2c_device_by_node(dser_node);
+	of_node_put(dser_node);
+
+	if (dser_i2c == NULL) {
+		errcode = -EINVAL;
+		goto error;
+	}
+	if (dser_i2c->dev.driver == NULL) {
+		dev_err(&client->dev, "missing deserializer driver\n");
+		errcode = -EINVAL;
+		goto error;
+	}
+	priv->dser_dev = &dser_i2c->dev;
+#endif
+
+	if(priv->cam_id == AR0821)
+	{
+		if(mipi_clk == 1200) {
+			g_max_cam = 4;
+		}
+		else if(mipi_clk == 576) {
+			g_max_cam = 8;
+		}
+	}
+	else
+		g_max_cam = 8;
+
+error:
+	return errcode;
+}
