+int reconfigure_deserializer(struct econ_stream_monitor *err_cam)
+{
+	uint8_t retry = 5;
+
+	while(retry--)
+	{
+		if(err_cam->cam->cam_id == AR0821)
+		{
+			/* Configuring Deserializer */
+			if(g_max_cam == 8)
+			{
+				if(serdes_parse_regdata(err_cam->client, DSER_CONF_8CAM,
+				       	dser8_array_size,err_cam->cam->dser_addr) < 0) {
+		
+					dev_err(&err_cam->client->dev,	
+						"%s: Failed to configure DESER Serializer\n",__func__);
+					continue;
+				}
+			}
+			else
+			{
+				if(serdes_parse_regdata(err_cam->client, DSER_CONF_4CAM,
+					       	dser4_array_size,err_cam->cam->dser_addr) < 0) {
+	
+					dev_err(&err_cam->client->dev,	
+							"%s: Failed to configure DESER Serializer\n",__func__);
+					continue;
+				}
+			}
+			msleep(10);
+
+		}
+		else if(err_cam->cam->cam_id == ISX031 || err_cam->cam->cam_id == AR0234)
+		{
+			if(serdes_parse_regdata(err_cam->client, DSER_CONF_8CAM,
+				dser8_array_size,err_cam->cam->dser_addr) < 0) {
+		
+				dev_err(&err_cam->client->dev,	
+					"%s: Failed to configure DESER Serializer\n",__func__);
+				continue;
+			}
+
+		}
+
+		/* Deserializer Speed Register */
+		if((serdes_write_16b_reg(err_cam->client, 
+				err_cam->cam->dser_addr, 0x0418, err_cam->cam->dser_speed)) < 0) {
+			dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+			continue;
+		}
+		msleep(10);
+	
+		if((serdes_write_16b_reg(err_cam->client, 
+				err_cam->cam->dser_addr, 0x041B, err_cam->cam->dser_speed)) < 0) {
+			dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+					__func__, __LINE__);
+			continue;
+		}
+		msleep(10);
+		pr_info("Reconfiguring Deserializer Successful");
+		return ERRCODE_SUCCESS;
+	}
+	return -EIO;
+}
