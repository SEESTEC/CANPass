+static int mcu_pwm_probe(struct i2c_client *client, const struct i2c_device_id *id)
+{
+
+	struct device_node *node = client->dev.of_node;
+	int  reset_gpio = 0, boot_gpio = 0, err = 0, ret = 0;
+	const char *str_trig;
+	struct device dev_mcu_pwm = client->dev ;
