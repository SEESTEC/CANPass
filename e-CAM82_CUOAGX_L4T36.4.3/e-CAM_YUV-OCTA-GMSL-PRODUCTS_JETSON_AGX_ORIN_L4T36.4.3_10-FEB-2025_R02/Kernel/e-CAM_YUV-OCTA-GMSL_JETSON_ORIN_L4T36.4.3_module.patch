+
+static int frame_sync_ctrl_handler(struct i2c_client *client,
+			struct cam *priv,struct v4l2_ctrl *ctrl){
+
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+        int mode = 0;
+
+        mode = s_data->mode;
+	
+	if(ctrl->id == V4L2_CID_TRIGGER_MODE)
+	{
+		priv->trigger_mode = ctrl->val;
+	}
+
+	else if(ctrl->id == V4L2_CID_CAM_MODE)
+	{
+		priv->current_cam_mode = ctrl->val;
+
+		if(priv->current_cam_mode != priv->last_cam_mode)
+		{
+			/* Decrementing the previous cam mode */
+			if((priv->last_cam_mode == AR0821_HDR_DAY_MODE) && (cam_track_day_hdr > 0)){
+				cam_track_day_hdr--;
+			}
+			else if((priv->last_cam_mode == AR0821_HDR_NIGHT_MODE) && (cam_track_night_hdr > 0)){
+				cam_track_night_hdr--;
+			}
+			else if((priv->last_cam_mode == AR0821_LINEAR_MODE) && (cam_track_linear > 0)){
+				cam_track_linear--;
+			}
+
+			/* Incrementing the Current Cam mode */
+			if(priv->current_cam_mode == AR0821_HDR_DAY_MODE && (cam_track_day_hdr < ar0821_num_cam)){
+				cam_track_day_hdr++;
+			}
+			else if(priv->current_cam_mode == AR0821_HDR_NIGHT_MODE && (cam_track_night_hdr < ar0821_num_cam)){
+				cam_track_night_hdr++;
+			}
+			else if(priv->current_cam_mode == AR0821_LINEAR_MODE && (cam_track_linear < ar0821_num_cam)){
+				cam_track_linear++;
+			}
+
+			/* Checking whether all the cameras are in same mode */
+			if(cam_track_day_hdr == ar0821_num_cam || cam_track_night_hdr == ar0821_num_cam || cam_track_linear == ar0821_num_cam)
+				is_all_cam_changed = 1;
+			else
+				is_all_cam_changed = 0;
+
+			priv->last_cam_mode = priv->current_cam_mode;
+		}
+	}
+
+	else if((ctrl->id == V4L2_CID_FRAME_SYNC || ctrl->id == V4L2_CID_PWM_CONFIG) && is_all_cam_changed && priv->trigger_mode)
+	{
+		if(ctrl->id == V4L2_CID_FRAME_SYNC)
+		{
+			if(ctrl->val == 0){
+                                priv->pwm_sync = 15;
+			}
+			else if(ctrl->val == 1){
+				if(mode == MODE_3840x2160 && g_max_cam == EIGHT_CAM){
+					priv->pwm_sync = 15;
+				}
+				else{
+					priv->pwm_sync = 30;
+				}
+			}
+			else{
+				if((cam_track_linear) && mode < MODE_3840x2160){
+					priv->pwm_sync = 60;  
+				}
+				else if(g_max_cam == EIGHT_CAM && mode == MODE_3840x2160){
+					priv->pwm_sync = 15;
+				}
+				else{
+					priv->pwm_sync = 30;
+				}
+			}
+		}
+		else
+		{
+			if(g_max_cam == EIGHT_CAM && mode == MODE_3840x2160 && priv->pwm_sync > 15) {
+				priv->pwm_sync = 15;
+			}
+			else if((priv->current_cam_mode != AR0821_LINEAR_MODE) && priv->pwm_sync > 30){
+         	            	priv->pwm_sync = 30;
+			}
+			else{
+				priv->pwm_sync = ctrl->val;
+			}
+		}
+		
+		/* Generating PWM for the required frequency */
+		if(priv->prev_pwm_sync != priv->pwm_sync){
+			dev_info(&client->dev,"  Recalibrating PWM For %dHz mode \n",priv->pwm_sync);
+			if (set_pwm_frequency(priv->pwm_sync, pwm_period, pwm_pulse) != 0){
+                       		pr_info("Error setting PWM Freqnency\n\r");
+                       	}	
+			priv->prev_pwm_sync = priv->pwm_sync;
+		}
+	}
+	return 0;
+}
