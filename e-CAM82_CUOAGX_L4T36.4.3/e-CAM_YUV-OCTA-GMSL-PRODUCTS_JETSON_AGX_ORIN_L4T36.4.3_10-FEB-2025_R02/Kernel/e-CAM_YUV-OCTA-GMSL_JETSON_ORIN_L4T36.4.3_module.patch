+static int ar0234_frame_sync_ctrl_handler(struct i2c_client *client,
+			struct cam *priv,struct v4l2_ctrl *ctrl){
+
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+        int mode = 0;
+
+	pr_info("\n prev pwm sync value = %d\n", priv->prev_pwm_sync);
+
+        mode = s_data->mode;
+
+	if(ctrl->val == last_frame_sync_mode){
+		//pr_info("\nSame framesync mode selected\nso calibration skipped..!!\n");
+		return 0;
+	}
+	else if(ctrl->val == 1){
+		priv->pwm_sync = 30;
+		last_frame_sync_mode=1;
+	}
+	else if(ctrl->val == 2){
+		priv->pwm_sync = 60;
+		last_frame_sync_mode=2;
+	}
+
+	if(priv->prev_pwm_sync != priv->pwm_sync){
+		dev_info(&client->dev,"  Recalibrating PWM For %dHz mode \n",priv->pwm_sync);
+		if (set_pwm_frequency(priv->pwm_sync, pwm_period, pwm_pulse) != 0)
+				pr_info("Error setting PWM Freqnency\n\r");
+
+		priv->prev_pwm_sync = priv->pwm_sync;
+	}
+
+	return 0;
+}
