+int ecam_mcu_core_initialize(struct i2c_client *client, struct cam *priv)
+{
+	int errcode = ERRCODE_SUCCESS;
+	uint8_t retry;
+	int16_t sensor_id = 0;
+	uint8_t fl_cn_status = 0x00;
+	uint8_t lp_pa_status = 0x00;
+	uint8_t nv_bt_status = 0x00;
+
+	/* Gets Sensor ID */
+	retry = 0;
+	while(retry++ < 5){
+		if (mcu_get_sensor_id(client, &sensor_id) < 0) 
+			dev_err(&client->dev, "Unable to get Sensor ID!.. Retrying..\n");
+		else
+			break;
+	}
+
+	if(retry > 5){
+		dev_err(&client->dev, 
+				"Unable to get Sensor ID!.. Exiting..\n");
+		return -EIO;
+	}
+	dev_info(&client->dev,"Sensor ID = 0x%x\n",sensor_id);
+	
+	/* Issue retry for init ISP */
+	retry = 10;
+	while(retry -- > 0) {
+		if (mcu_isp_init(client) < 0) {
+			dev_err(&client->dev,
+			       	"Unable to INIT ISP, retry = %d \n", retry);
+			continue;
+		} else {
+			break;
+		}
+	}
+
+	if(retry == 0) {
+		dev_err(&client->dev, "Unable to INIT ISP \n");
+		return -EFAULT;
+	}
+
+	msleep(10);
+	
+	if(priv->cam_id == ISX031)
+	{
+		retry = 0;
+		while(retry++ < 5){
+			errcode = mcu_get_flash_connect_status(client, &fl_cn_status);
+			if(errcode != 0){
+				dev_err(&client->dev, 
+					"Retrying to get FLASH CONNECT STATUS !..\n");
+				/* Handling in case of ACK Failure */
+				if(errcode == ERRCODE_AGAIN)
+				{
+					pr_info("Setting ACK Response Mode");
+					set_ack_response_mode(client);
+					/* 
+					 * Providing One Frame time 
+					 * delay after Stream On 
+					 */
+					msleep(50);
+				}
+				continue;
+			}
+			else
+				break;
+		}
+
+		if(retry > 5){
+			dev_err(&client->dev, 
+				"Unable to get fl Connect STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&client->dev,
+			"Fl Connect Status = 0x%02x\n",fl_cn_status);
+
+		if(fl_cn_status != 0x01)
+		{
+			pr_info("FLASH Device is Corrupted");
+			return -EIO;
+		}
+
+		msleep(1);
+
+		retry = 0;
+		while(retry++ < 5){
+		if (mcu_get_load_param_status(client, &lp_pa_status) < 0) {
+			dev_err(&client->dev, 
+				"Unable to get Load Param STATUS!.. Retrying..\n");
+			continue;
+		}
+		else
+			break;
+		}
+		if(retry > 5){
+			dev_err(&client->dev, 
+				"Unable to get Load Param STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&client->dev,"Load Param Status = 0x%02x\n",lp_pa_status);
+
+		if(lp_pa_status != 0x01)
+		{
+			pr_info("The sensor does not load the Serial NOR Flash device"
+			       " at sensor startup");
+			return -EIO;
+		}
+	
+		msleep(1);
+
+		retry = 0;
+		while(retry++ < 5){
+		if (mcu_get_nv_boot_status(client, &nv_bt_status) < 0) {
+			dev_err(&client->dev, 
+				"Unable to get NV Boot STATUS!.. Retrying..\n");
+			continue;
+		}
+		else
+			break;
+		}
+		if(retry > 5){
+			dev_err(&client->dev, 
+				"Unable to get NV Boot STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&client->dev,"NV BOOT  Status = 0x%02x\n",nv_bt_status);
+	
+		if(nv_bt_status != 0x01)
+		{
+			pr_info("A load operation from Flash is unsuccessful");
+			return -EIO;
+		}
+	}
+
+	return errcode;
+}
+
+int mcu_configurations(struct i2c_client *client, struct cam *priv)
+{
+	int errcode = ERRCODE_SUCCESS;
+	uint8_t retry;
+
+	/* Query the number of Controls from MCU */
+	retry = 5;
+	while (--retry >= 0) {
+		if(mcu_list_ctrls(client, NULL, priv) < 0) {
+			dev_err(&client->dev, "%s, init controls failure.\
+				      		retrying \n", __func__);
+			continue;
+		} else {
+		  	break;
+		}
+	}
+	if (retry < 0) {
+	  	dev_err(&client->dev, "%s, Failed to init controls \n",
+			      				__func__);
+		errcode = -EFAULT;
+		goto mcu_config_error;
+	}
+
+	/*Query the number for Formats available from MCU */
+	retry = 5;
+	while (--retry >= 0) {
+		if(mcu_list_fmts(client, NULL, &frm_fmt_size, priv) < 0) {
+			dev_err(&client->dev,
+				"%s, init formats failure. retrying \n",
+			       					__func__);
+			continue;
+		} else {
+		  	break;
+		}
+	}
+
+	if (retry < 0) {
+	  	dev_err(&client->dev, "%s, Failed to init formats!\n",
+			     				__func__);
+	  	errcode = -EFAULT;
+		goto mcu_config_error;
+	}
+
+	
+	priv->mcu_ctrl_info = devm_kzalloc(&client->dev, 
+		sizeof(ISP_CTRL_INFO) * priv->num_ctrls, GFP_KERNEL);
+	if(!priv->mcu_ctrl_info) {
+		dev_err(&client->dev, "Unable to allocate memory \n");
+		errcode = -ENOMEM;
+		goto mcu_config_error;
+	}
+
+	priv->ctrldb = devm_kzalloc(&client->dev,
+		     sizeof(uint32_t) * priv->num_ctrls, GFP_KERNEL);
+	if(!priv->ctrldb) {
+		dev_err(&client->dev, "Unable to allocate memory \n");
+		errcode = -ENOMEM;
+		goto mcu_config_error;
+	}
+
+	priv->stream_info = devm_kzalloc(&client->dev, 
+		sizeof(ISP_STREAM_INFO) * (frm_fmt_size + 1), GFP_KERNEL);
+
+	priv->streamdb = devm_kzalloc(&client->dev,
+		      sizeof(int) * (frm_fmt_size + 1), GFP_KERNEL);
+	if(!priv->streamdb) {
+		dev_err(&client->dev,"Unable to allocate memory \n");
+		errcode = -ENOMEM;
+		goto mcu_config_error;
+	}
+
+	priv->mcu_cam_frmfmt = devm_kzalloc(&client->dev, 
+		sizeof(struct camera_common_frmfmt) * (frm_fmt_size), 
+								GFP_KERNEL);
+	if(!priv->mcu_cam_frmfmt) {
+		dev_err(&client->dev, "Unable to allocate memory \n");
+		errcode = -ENOMEM;
+		goto mcu_config_error;
+	}
+
+mcu_config_error:
+	return errcode;
+}
+
+static int cam_read(struct i2c_client *client, u8 * val, u32 count)
+{
+	int ret;
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = 0,
+		.buf = val,
+	};
+
+	msg.flags = I2C_M_RD;
+	msg.len = count;
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret < 0)
+		goto err;
+
+	return 0;
+
+err:
+	dev_err(&client->dev, "Failed reading register ret = %d!\n", ret);
+	return ret;
+}
+
+unsigned char errorcheck(char *data, unsigned int len)
+{
+	unsigned int i = 0;
+	unsigned char crc = 0x00;
+
+	for (i = 0; i < len; i++) {
+		crc ^= data[i];
+	}
+
+	return crc;
+}
+
+static int cam_write(struct i2c_client *client, u8 * val, u32 count)
+{
+	int ret;
+	struct i2c_msg msg = {
+		.addr = client->addr,
+		.flags = 0,
+		.len = count,
+		.buf = val,
+	};
+
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret < 0) {
+		dev_err(&client->dev, 
+			"Failed writing register ret = %d!\n",ret);
+		return ret;
+	}
+
+	return 0;
+}
