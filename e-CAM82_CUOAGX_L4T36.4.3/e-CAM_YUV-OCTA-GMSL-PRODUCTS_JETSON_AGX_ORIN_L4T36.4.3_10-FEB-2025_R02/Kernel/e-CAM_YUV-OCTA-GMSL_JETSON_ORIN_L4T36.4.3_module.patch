diff --git a/Load_Switch/chip_read.c b/Load_Switch/chip_read.c
new file mode 100644
index 0000000..2802118
--- /dev/null
+++ b/Load_Switch/chip_read.c
@@ -0,0 +1,105 @@
+#include "load_switch_driver.h"
+
+
+int power_line_write_i2c(struct i2c_client *client, u8 sladdr,  u8 * val, u32 count)
+{
+	int ret;
+
+	struct i2c_msg msg = {
+		.addr = sladdr,
+		.flags = 0,
+		.len = count,
+		.buf = val,
+	};
+
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret < 0) {
+		dev_err(&client->dev, "Failed writing register ret = %d!\n",
+			ret);
+		return ret;
+	}
+	return 0;
+}
+
+int power_line_read_i2c(struct i2c_client *client, u8 sladdr, u8 * val, u32 count)
+{
+	int ret;
+	struct i2c_msg msg = {
+		.addr = sladdr,
+		.flags = 0,
+		.buf = val,
+	};
+
+	msg.flags = I2C_M_RD;
+	msg.len = count;
+	ret = i2c_transfer(client->adapter, &msg, 1);
+	if (ret < 0)
+		goto err;
+
+	return 0;
+
+ err:
+	dev_err(&client->dev, "Failed reading register ret = %d!\n", ret);
+	return ret;
+}
+
+/*
+s32 power_line_read_8b_reg(struct i2c_client *client, u8 sladdr, u8 reg, u8 val)
+{
+	u8 bcount = 2;
+	u8 au8Buf[2] = { 0 };
+
+	au8Buf[0] = reg;
+	au8Buf[1] = val;
+
+	if (power_line_read_i2c(client, sladdr,au8Buf, bcount) < 0) {
+		dev_err(&client->dev,
+			"%s:write reg error: reg = 0x%x,val = 0x%x\n", __func__,
+			reg, val);
+		return -EIO;
+	}
+	return 0;
+}
+*/
+
+s32 power_line_read_8b_reg(struct i2c_client *client, u8 sladdr, u8 reg, u8 * val)
+{
+	u8 bcount = 1;
+	u8 au8RegBuf[1] = { 0 };
+	u8 au8RdVal[1] = { 0 };
+
+	au8RegBuf[0] = reg;
+
+	if (power_line_write_i2c(client, sladdr, au8RegBuf, bcount) < 0) {
+		dev_err(&client->dev,"%s:write reg error:reg=0x%x\n", __func__, reg);
+		return -EIO;
+	}
+
+	if (power_line_read_i2c(client,sladdr, au8RdVal, bcount) < 0) {
+		dev_err(&client->dev,"%s:read reg error:reg=0x%x\n", __func__, reg);
+		return -EIO;
+	}
+
+	*val = au8RdVal[0];
+
+	return 0;
+}
+
+s32 power_line_write_8b_reg(struct i2c_client *client, u8 sladdr, u8 reg, u8 val)
+{
+	u8 bcount = 2;
+	u8 au8Buf[2] = { 0 };
+
+	au8Buf[0] = reg;
+	au8Buf[1] = val;
+
+	if (power_line_write_i2c(client, sladdr,au8Buf, bcount) < 0) {
+		dev_err(&client->dev,
+			"%s:write reg error: reg = 0x%x,val = 0x%x\n", __func__,
+			reg, val);
+		return -EIO;
+	}
+
+	return 0;
+}
+
diff --git a/Load_Switch/chip_read.h b/Load_Switch/chip_read.h
new file mode 100644
index 0000000..8f98828
--- /dev/null
+++ b/Load_Switch/chip_read.h
@@ -0,0 +1,15 @@
+#ifndef __READ_H
+#define __READ_H
+
+#define LOAD_SWITCH_1_ADDR 	0x29	/* i2c bus 34 */
+#define LOAD_SWITCH_2_ADDR	0x28	/* i2c bus 35 */
+#define LOAD_SWITCH_CHIP_ID   	0x21
+#define LOAD_SWITCH_STATUS_REG	0x01
+#define CHIP_ID_REG		0x02
+
+int power_line_read_i2c(struct i2c_client *client, u8 sladdr, u8 * val, u32 count);
+s32 power_line_read_8b_reg(struct i2c_client *client, u8 sladdr, u8 reg, u8 *val);
+s32 power_line_write_8b_reg(struct i2c_client *client, u8 sladdr, u8 reg, u8 val);
+int8_t set_load_switch_status(const char *dser_port, uint8_t dser_status);
+
+#endif /* __READ_H */
diff --git a/Load_Switch/load_switch_driver.c b/Load_Switch/load_switch_driver.c
new file mode 100644
index 0000000..573b386
--- /dev/null
+++ b/Load_Switch/load_switch_driver.c
@@ -0,0 +1,213 @@
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/gpio.h>
+#include <linux/module.h>
+
+#include <linux/seq_file.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_gpio.h>
+
+#include<linux/fs.h>
+#include<linux/string.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+
+
+#include <linux/gpio/driver.h>
+#include <linux/mutex.h>
+
+#include "chip_read.h"
+
+uint8_t load_switch_1_status, load_switch_2_status;
+struct i2c_client *device1_client;
+struct i2c_client *device2_client;
+
+/*
+ * probe function for load switch IC
+ */
+static int load_switch_probe(struct i2c_client *client, 
+		const struct i2c_device_id *id)
+{
+	struct device_node *node = client->dev.of_node;
+	uint8_t chip_id = 0, load_switch_addr = 0;
+	int err;
+	const char *str;
+
+	dev_info(&client->dev,"Probing Load Switch Driver\n");
+
+	if (!IS_ENABLED(CONFIG_OF) || !node)
+	{
+		printk("NODE IS INVALID : Unable to load Driver\n");
+		return -EINVAL;
+	}
+
+	err = of_property_read_string(node, "deser_port", &str);
+	if (!err) 
+	{
+		pr_info("DSER PORT = %s",str);
+		if(!(strcmp(str, "A"))){
+			device1_client = client;
+			load_switch_addr = LOAD_SWITCH_1_ADDR;
+		}
+		else if(!(strcmp(str, "B"))){
+			device2_client = client;
+			load_switch_addr = LOAD_SWITCH_2_ADDR;
+		}
+		else{
+			dev_err(&client->dev, 
+				"Invalid Deserializer Port");
+			return -EIO;
+		}
+
+		if(power_line_read_8b_reg(client,
+			load_switch_addr, CHIP_ID_REG, &chip_id) < 0)
+		{
+		     dev_err (&client->dev, "%s(%d): Failed\n"
+				     ,__func__, __LINE__);
+		     return -EIO;
+		}
+	}
+	
+	if(chip_id != LOAD_SWITCH_CHIP_ID) 
+	{
+		dev_err(&client->dev," Invalid Chip ID = %0x\n",chip_id);
+		dev_err(&client->dev," Exiting probe\n");
+		return -ENODEV;
+	}
+
+	/* Enabling Load Switch Status */
+	if(power_line_write_8b_reg(client,
+		load_switch_addr,LOAD_SWITCH_STATUS_REG,0x1f) < 0)
+	{
+		dev_err (&client->dev, "%s(%d): Failed\n"
+				,__func__, __LINE__);
+		return -EIO;
+	}
+	
+	dev_info(&client->dev,
+		"Detected Load Switch\n");
+	return 0;
+}
+
+int8_t set_load_switch_status(const char *dser_port, uint8_t dser_status)
+{
+	uint8_t load_switch_addr = 0, load_switch_status = 0;
+	struct i2c_client *device_client;
+	uint8_t bit_0, bit_1, bit_2, bit_3 = 0;
+
+	/* 
+	 * Extracting individual bits from Deserialzier status 
+	 * to map according to the Load Switch Status
+	 */
+	bit_0 = (dser_status & 1);
+	bit_1 = ((dser_status >> 1) & 1);
+	bit_2 = ((dser_status >> 2) & 1);
+	bit_3 = ((dser_status >> 3) & 1);
+
+	if(!(strcmp(dser_port, "A")))
+	{
+		load_switch_addr = LOAD_SWITCH_1_ADDR;
+		device_client = device1_client;
+
+		/* 
+		 * If dser_port is "A" 
+		 * bit_0 is mapped for PHY_B
+		 * bit_1 is mapped for PHY_A
+		 * bit_2 is mapped for PHY_C
+		 * bit_3 is mapped for PHY_D
+		 */
+		load_switch_status |= (bit_0 << 1);
+		load_switch_status |= (bit_1);
+		load_switch_status |= (bit_2 << 2);
+		load_switch_status |= (bit_3 << 3);
+
+	}
+	else if(!(strcmp(dser_port, "B")))
+	{
+		load_switch_addr = LOAD_SWITCH_2_ADDR;
+		device_client = device2_client;
+
+		/* 
+		 * If dser_port is "B" 
+		 * bit_0 is mapped for PHY_C
+		 * bit_1 is mapped for PHY_D
+		 * bit_2 is mapped for PHY_B
+		 * bit_3 is mapped for PHY_A
+		 */
+		load_switch_status |= (bit_0 << 3);
+		load_switch_status |= (bit_1 << 2);
+		load_switch_status |= (bit_2);
+		load_switch_status |= (bit_3 << 1);
+
+	}
+	else
+	{
+		dev_err(&device_client->dev,
+			"Invalid Dserializer port in %s(%d)",
+		       			__func__,__LINE__);
+		return -EIO;
+	}
+
+	if(power_line_write_8b_reg(device_client,
+		load_switch_addr,LOAD_SWITCH_STATUS_REG,load_switch_status) < 0)
+	{
+		dev_err (&device_client->dev, "%s(%d): Failed\n"
+				,__func__, __LINE__);
+		return -EIO;
+	}
+	pr_info("Set Load switch Status Success");
+
+	return 0;
+}
+
+/*
+ * remove function for Load Switch IC
+ */
+static int load_switch_remove(struct i2c_client *client)
+{
+
+	struct device_node *node = client->dev.of_node;
+	const char *str;
+	uint8_t err;
+
+	err = of_property_read_string(node, "deser_port", &str);
+	pr_info("DSER PORT = %s",str);
+	if(err)
+		return -EIO;
+
+	printk("Device unbound successfully\n");
+
+	return 0;
+}
+
+EXPORT_SYMBOL(set_load_switch_status);
+
+static struct of_device_id load_switch_of_match[] = {
+	{.compatible = "nvidia,load_switch",},
+	{},
+};
+
+static struct i2c_device_id load_switch_id[] = {
+	{"load_switch", 0},
+	{}
+};
+
+MODULE_DEVICE_TABLE(i2c, load_switch_id);
+
+static struct i2c_driver load_switch_i2c_driver = {
+	.driver = {
+		.name = "load_switch",
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(load_switch_of_match),
+	},
+	.probe = load_switch_probe,
+	.remove = load_switch_remove,
+	.id_table = load_switch_id,
+};
+module_i2c_driver(load_switch_i2c_driver);
+
+MODULE_DESCRIPTION("Load switch driver for e-con Cameras");
+MODULE_AUTHOR("E-Con Systems");
+MODULE_LICENSE("GPL v2");
+
