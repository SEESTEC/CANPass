+	if(dser_err_handler(err_cam) < 0){
+		pr_info("Error in %s(%d)\n",__func__,__LINE__);
+		return -EIO;
+	}
+
+	/* Checks PCLK Detection in Serialzier */
+	if(ser_err_handler(err_cam, NULL, 0) < 0){
+		pr_info("Error in %s(%d)\n",__func__,__LINE__);
+		return -EIO;
+	}
+
+	/* Detects the MCU */
+	if(mcu_err_handle(err_cam, 0) < 0){
+		pr_info("Error in %s(%d)\n",__func__,__LINE__);
+		return -EIO;
+	}
+
+	/* Checks the ISP and Sensor Frame Counts */
+	if(isp_sensor_err_handle(err_cam) < 0){
+		pr_info("Error in %s(%d)\n",__func__,__LINE__);
+		return -EIO;
+	}
+	return 0;
+}
