+int isp_frame_count_read (struct econ_stream_monitor *err_cam)
+{	
+	uint16_t reg_addr = 0;
+	uint8_t reg_len = 0, frm_chk_cnt = 0, is_frm_cnt_increasing = 0;
+	int ret_val = 0, prev_frm_cnt = 0;
+
+	if(err_cam->cam->cam_id == AR0821 || err_cam->cam->cam_id == AR0234)
+		reg_addr = ISP_FRM_CNT_REG;
+	else if(err_cam->cam->cam_id == ISX031)
+		reg_addr = 0x7DC8;
+
+	reg_len = TWO_BYTE;
+
+	
+	while(frm_chk_cnt++ < 10) {
+		if((ret_val = sensor_isp_read(err_cam->client, 
+					reg_addr, reg_len)) < ERRCODE_SUCCESS) {
+			pr_info("In %s sensor_write_failed\n",__func__);
+			continue;
+		}
+		msleep(100);
+		
+		dev_dbg(&err_cam->client->dev, "ISP frame count = %d\n",ret_val);
+		pr_info("ISP frame count = %d\n",ret_val);
+
+		if(!prev_frm_cnt){
+			prev_frm_cnt = ret_val;
+			continue;
+		}
+		
+		if(prev_frm_cnt != ret_val) {
+			pr_info("ISP Outputs the Frames Properly\n");
+			return ERRCODE_SUCCESS;
+		}
+		else{
+			continue;
+		}
+	}
+	pr_info("ISP frame count read Failed\n");
+	return -EIO;
+}
+
+int get_isp_sensor_standby_state(struct econ_stream_monitor *err_cam)
+{
+	int ret_val = 0;
+	uint16_t reg_addr = 0;
+	uint8_t reg_len = 0, retry = 0;
+
+	if(err_cam->cam->cam_id == AR0821 || err_cam->cam->cam_id == AR0234)
+		reg_addr = ISP_STANDBY_REG;
+	else if(err_cam->cam->cam_id == ISX031)
+		reg_addr = 0x6005;
+
+	reg_len = TWO_BYTE;
+
+	while(retry++ < 5)
+	{
+		ret_val = sensor_isp_read(err_cam->client, reg_addr, reg_len);
+		if(ret_val < ERRCODE_SUCCESS){
+			msleep(50);
+			continue;
+		}
+	
+		if(ret_val & ISP_STREAMING_STATE) {
+			pr_info("ISP is in Streaming mode\n");
+			return ERRCODE_SUCCESS;
+		}
+		else {
+			pr_info("ISP is in standby mode\n");
+		}
+		break;
+	}
+	if(retry >= 5)
+		return -EIO;
+	
+	retry = 0;
+	while(retry++ > 5)
+	{
+		if(err_cam->cam->cam_id == AR0821 || err_cam->cam->cam_id == AR0234)
+		{	
+			if( get_mipi_sensor_standby_state(err_cam) < 0){
+				msleep(50);
+				continue;
+			}
+			break;
+		}
+	}
+	if(retry >= 5)
+		return -EIO;
+	
+	return 0;
+
+}
+
+int get_isp_sensor_chip_id (struct econ_stream_monitor *err_cam)
+{ 
+	int ret_val = 0;
+	uint16_t reg_addr = 0;
+	uint8_t reg_len = 0;
+
+	int retry = 0;
+
+	if(err_cam->cam->cam_id == AR0821 || err_cam->cam->cam_id == AR0234)
+		reg_addr = ISP_CHIP_ID_REG;
+	else if(err_cam->cam->cam_id == ISX031)
+		reg_addr = 0x8A54;
+
+	reg_len = TWO_BYTE;
+
+	while(retry++ < 5)
+	{
+		ret_val = sensor_isp_read(err_cam->client, reg_addr, reg_len);
+		if(ret_val > 0){
+			pr_info("ISP Chip ID = 0x%02x\n",ret_val);
+			break;
+		}
+		msleep(100);	
+	}
+	
+	if(retry > 5){
+		pr_info("ISP Chip is not detected =0x%2x \n",ret_val);
+		return -EIO;
+	}
+	
+	return ERRCODE_SUCCESS;
+}
+
+int isp_sensor_err_handle(struct econ_stream_monitor *err_cam)
+{
+	int ret_val = 0;
+	uint16_t reg_addr = 0;
+	uint8_t reg_len = 0;
+	if(get_isp_sensor_chip_id(err_cam) < ERRCODE_SUCCESS)
+	{
+		pr_info("Error in ISP/Sensor Chip ID!\
+				\nso skipping frame count check\n");
+		return -EIO;
+	}
+
+	if(get_isp_sensor_standby_state(err_cam) < ERRCODE_SUCCESS){
+		pr_info("ISP/Sensor is in standby mode"\
+				"\nso skipping frame count check\n");
+		return -EIO;
+	}
+	
+	if(err_cam->cam->cam_id == AR0821 || err_cam->cam->cam_id == AR0234)
+	{
+		/* Check the Sensor Frame count */
+		if(get_sensor_frame_count(err_cam) < 0){
+			return -EIO;
+		}
+	}
+
+	if( (ret_val= isp_frame_count_read(err_cam)) < ERRCODE_SUCCESS){
+		pr_info("Error in ISP, Need to reset\n");
+		return -EIO;
+	}
+	return ERRCODE_SUCCESS;
+}
