+static int isx031_get_xerror_status(void *data)
+{
+	struct i2c_client *client = ( struct i2c_client *)data;
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+	struct cam *priv = (struct cam *)s_data->priv;
+	uint8_t XERROR_STATUS_VALUE[100];
+	int i = 0;
+	static int check_error = 0;
+
+	present_prove_var_isx031_count = priv->probe_value_local;
+
+	memset(XERROR_STATUS_VALUE, 0, 100);
+	while (!kthread_should_stop()) {
+		if (prove_var_isx031_count >=8 && 
+			( mcu_get_xerror_status(client, 
+					&XERROR_STATUS_VALUE[0]) < 0 ) ) 
+		{
+			dev_err(&client->dev, 
+				"Unable to get XERROR STATUS \n");
+		}
+		msleep(2000);
+
+		priv->priv_pid = pid[priv->probe_value_local];
+
+		if(priv->stream_on_call == 1){
+			for(i = 0; i<40; i++){
+				if(XERROR_STATUS_VALUE[i] == 1){
+
+					struct siginfo xerror_info;
+					memset(&xerror_info, 0, sizeof(struct siginfo));
+					xerror_info.si_signo = SIGXERROR;
+					xerror_info.si_code = SI_QUEUE;
+					xerror_info.si_int = (priv->probe_value_local << 8 ) | ( i & 0xFF ) ; 
+					rcu_read_lock();
+					xerror_task = pid_task(find_pid_ns(priv->priv_pid,
+						       	&init_pid_ns), PIDTYPE_PID);
+					if (xerror_task != NULL) {
+    						rcu_read_unlock();      
+    						if (send_sig_info(SIGXERROR, (struct kernel_siginfo *)&xerror_info, xerror_task) < 0) 
+        						pr_info("send_sig_info error\n");
+					} else {
+     						pr_info("pid_task error\n");
+     						rcu_read_unlock();
+					}	
+				}
+			}
+		}
+		schedule();
+	}
+	return 0;
+}
