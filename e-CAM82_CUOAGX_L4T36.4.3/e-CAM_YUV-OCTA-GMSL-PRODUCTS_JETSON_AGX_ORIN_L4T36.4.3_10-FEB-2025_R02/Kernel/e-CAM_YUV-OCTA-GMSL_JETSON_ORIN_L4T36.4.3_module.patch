+static int cam_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam *priv =
+		container_of(ctrl->handler, struct cam, ctrl_handler);
+	struct i2c_client *client = priv->i2c_client;
+	int err = 0;
+
+	uint8_t ctrl_type = 0;
+	int ctrl_val = 0;
+	if (!priv || !priv->pdata)
+		return -EINVAL;
+
+	if (priv->power.state == SWITCH_OFF)
+		return 0;
+
+	if ((err = mcu_get_ctrl(client, ctrl->id, &ctrl_type, &ctrl_val)) < 0){
+		return err;
+	}
+
+	if (ctrl_type == CTRL_STANDARD) {
+		ctrl->val = ctrl_val;
+	} else {
+		/* Not Implemented */
+		return -EINVAL;
+	}
+
+	return err;
+}
+
+static int cam_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cam *priv =
+		container_of(ctrl->handler, struct cam, ctrl_handler);
+	struct i2c_client *client = priv->i2c_client;
+	int err = 0, retry = 5;
+
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+        int mode = 0;
+
+        mode = s_data->mode;
+
+	if (!priv || !priv->pdata)
+		return -EINVAL;
+
+	if (priv->power.state == SWITCH_OFF)
+		return 0;
+	
+	while(retry -- > 0) {
+		if ((err = mcu_set_ctrl(client, ctrl->id, 
+				CTRL_STANDARD, ctrl->val)) < 0) {
+			dev_info(&client->dev," %s (%d ) retry \n",
+				       		__func__, __LINE__);
+			dev_info(&client->dev," %s (%d ) retry \n",
+				       		__func__, ctrl->id);
+			if(retry <= 0) {
+				dev_err(&client->dev," %s (%d ) \n",
+					       	__func__, __LINE__);
+				break;
+			} else {
+				continue;
+			}
+		}
+		break;
+	}
+
+	if(priv->cam_id == AR0821)
+	{
+		if ((err = frame_sync_ctrl_handler(client,priv,ctrl)) < 0) {
+        		dev_info(&client->dev," %s (%d ) \n", __func__, __LINE__);
+        	}
+	}
+	else if(priv->cam_id == AR0234 && ctrl->id == V4L2_CID_FRAME_SYNC && ctrl->val !=0)
+	{
+		if ((err = ar0234_frame_sync_ctrl_handler(client,priv,ctrl)) < 0) {
+			dev_info(&client->dev," %s (%d ) \n", __func__, __LINE__);
+		}
+	}
+
+	return err;
+}
