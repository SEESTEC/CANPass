+static ssize_t sysfs_ecam_status_check_enable(struct kobject *kobj, 
+                struct kobj_attribute *attr,const char *buf, size_t count)
+{
+	pr_info("Sysfs - Write!!!\n");
+	sscanf(buf,"%d",&ecam_status_check);
