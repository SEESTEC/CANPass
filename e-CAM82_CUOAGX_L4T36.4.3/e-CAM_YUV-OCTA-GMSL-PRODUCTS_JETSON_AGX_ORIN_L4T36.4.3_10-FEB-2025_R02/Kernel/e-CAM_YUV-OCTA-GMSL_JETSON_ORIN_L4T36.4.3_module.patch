+       uint16_t cmd_status = 0;
+       uint8_t retcode = 0, cmd_id = 0;
+       int retry = 5,status_retry=1000, err = 0;
+       struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+       struct cam *priv = (struct cam *)s_data->priv;
+       uint8_t mc_data[512], mc_ret_data[512];
+
+       mutex_lock(&g_i2c_mutex);
+
+       /* First Txn Payload length = 0 */
+       payload_len = 0;
+
+       mc_data[0] = CMD_SIGNATURE;
+       mc_data[1] = CMD_ID_SET_ACK_RESPONSE_MODE;
+       mc_data[2] = payload_len >> 8;
+       mc_data[3] = payload_len & 0xFF;
+       mc_data[4] = errorcheck(&mc_data[2], 2);
+
+       err= cam_write(client, mc_data, TX_LEN_PKT);
+       if (err != 0) {
+	       dev_err(&client->dev,
+               		" %s(%d) Write Error - %d \n",
+                        	__func__,__LINE__, err);
+                       	return -EIO;
+       }
+	
+       mc_data[0] = CMD_SIGNATURE;
+       mc_data[1] = CMD_ID_SET_ACK_RESPONSE_MODE;
+       err = cam_write(client, mc_data, 2);
+       if (err != 0) {
+       		dev_err(&client->dev,
+                	" %s(%d) Write Error - %d \n",
+                        	__func__,__LINE__, err);
+               	return -EIO;
+       }
+
+       while (status_retry-- > 0) {
+     		/* Some Sleep for init to process */
+       		yield();
+       		msleep(100);
+
+       		cmd_id = CMD_ID_SET_ACK_RESPONSE_MODE;
+       		if (mcu_get_cmd_status(client,
+       			&cmd_id, &cmd_status, &retcode) < 0) {
+                		dev_err(&client->dev,
+                        		" %s(%d) Get CMD Error \n",
+                                		__func__,__LINE__);
+                       		err = -1;
+                        	goto exit;
+       		}
+
+      	 	if ((retcode == ERRCODE_SUCCESS)) {
+       			pr_info("Set ACK Response Mode Success !! \n");
+               		err = retcode;
+               		goto exit;
+       		}
+       }
+exit:
+
+       mutex_unlock(&g_i2c_mutex);
+       return err;     
+       
+}
+
+int isx031_chk_flash_and_isp_bootdata(struct i2c_client *client, struct cam *priv, 
+		uint8_t spi_flash_bootdata_changed)
+{
+	int errcode = ERRCODE_SUCCESS;
+	uint8_t retry = 0;
+	uint8_t fl_cn_status, lp_pa_status, nv_bt_status = 0;
+
+	if(!is_fw_loaded_ISP){
+		if(ecam_mcu_firmware_load_ISP(client) < 0){
+			dev_err(&client->dev,"failed to load mcu firmware\n");
+				return -ENOENT;
+		}
+		else{
+			pr_info("Firmware Successfully read by driver\n");
+			is_fw_loaded_ISP = 1;
+		}
+	}
+
+	retry = 0;
+	while(retry++ < 5){
+		errcode = mcu_get_flash_connect_status(client, &fl_cn_status);
+		if(errcode != 0){
+			dev_err(&client->dev, 
+				"Retrying to get FLASH CONNECT STATUS !..\n");
+			pr_info("ERRCODE = %d",errcode);
+			/* Handling in Case of ACK Failure */
+			if(errcode == ERRCODE_AGAIN)
+			{
+				pr_info("Setting ACK Response Mode");
+				set_ack_response_mode(client);
+				/* 
+				 * Providing One Frame time Dealy 
+				 * after Stream On 
+				 */
+				msleep(50);
+			}
+			continue;
+		}
+		else
+			break;
+	}
+	if(retry > 5){
+		dev_err(&client->dev, 
+			"Unable to get FLASH CONNECT STATUS !\n");
+	}
+	else
+		dev_info(&client->dev,
+			"Fl Connect Status = 0x%02x\n",fl_cn_status);
+
+
+	if( (fl_cn_status != 0x01)){
+
+		dev_err(&client->dev, "FLASH IS NOT CONNECTED \n");
+		dev_err(&client->dev,"Either Flash Corrupted or Camera Module is Not connected\n");
+		msleep(100);
+		goto bootdata_flash;
+	}
+	
+	msleep(1);
+	
+	if(( spi_flash_bootdata_changed == 0x01 ))
+	{
+
+		pr_info("SPI FLASH Initiated Due to change in Boot-Data\n");
+		goto bootdata_flash;
+
+	}
+
+	retry = 0;
+	while(retry++ < 5){
+	if (mcu_get_load_param_status(client, &lp_pa_status) < 0) {
+		dev_err(&client->dev, "Unable to get LOAD PARAM STATUS !.. Retrying..\n");
+		continue;
+	}
+	else
+		break;
+	}
+	if(retry > 5){
+		dev_err(&client->dev, 
+				"Unable to get LOAD PARAM STATUS !.. Exiting..\n");
+		return -EFAULT;
+	}
+	dev_info(&client->dev,"Load Param Status = 0x%02x\n",lp_pa_status);
+
+	if( lp_pa_status != 0x01 ){
+
+		dev_err(&client->dev, "SERIAL NOR FLASH IS NOT LOADED WITH DATA AT SENSOR START UP\nSKIP NV_BOOT STATUS Check and Write Boot_data to NOR FLASH\n");
+		goto bootdata_flash;
+	}	
+
+	msleep(1);
+	retry = 0;
+	while(retry++ < 5){
+	if (mcu_get_nv_boot_status(client, &nv_bt_status) < 0) {
+		dev_err(&client->dev, "Unable to get NV Boot STATUS!.. Retrying..\n");
+		continue;
+	}
+	else
+		break;
+	}
+	if(retry > 5){
+		dev_err(&client->dev, 
+				"Unable to get NV Boot STATUS!.. Exiting..\n");
+		return -EFAULT;
+	}
+	dev_info(&client->dev,"NV BOOT  Status = 0x%02x\n",nv_bt_status);
+
+	if( fl_cn_status == 0x01 && lp_pa_status == 0x01 && nv_bt_status == 0x01 ){
+
+		dev_info(&client->dev,"SPI BOOTDATA IS VALID & SENSOR WILL BOOT FROM SPI\n\r");
+		goto skip_bootdata_flash;	
+
+	}
+
+bootdata_flash:
+
+#ifdef PROBE_STATUS
+	sprintf(probe_status_array[total_num_cam].spi_fw_status, "Updating");
+	probe_status_array[total_num_cam].spi_fw_status_percentage = 5;
+	probe_status_array[total_num_cam].percentage = 70;
+#endif	
+	retry = 5;
+	while(retry -- > 0) {
+		if (Sensor_flash_wp_disable(client) < 0) {
+			dev_err(&client->dev,
+		       		"Unable to ACCESS FLASH = %d \n", retry);
+			continue;
+		}
+		break;
+	}
+			
+	if( retry <= 0 )
+		return -EFAULT;
+
+	msleep(200);
+#ifdef PROBE_STATUS
+	probe_status_array[total_num_cam].spi_fw_status_percentage = 10;		
+#endif
+	retry = 5;
+	while(retry -- > 0) {
+		if (mcu_isp_init_ISP_ERASE_FLASH(client) < 0) {
+			dev_err(&client->dev,
+		       		"Unable to ERASE SPI"
+			       		" FLASH DATA,retry = %d \n",retry);
+			continue;
+		}
+		break;
+	}
+			
+	if( retry <= 0 )
+		return -EFAULT;
+#ifdef PROBE_STATUS
+	probe_status_array[total_num_cam].spi_fw_status_percentage = 20;		
+#endif	
+	retry = 5;
+	while(retry -- > 0) {
+		if (mcu_isp_init_ISP(client) < 0) {
+			dev_err(&client->dev,
+		  		"Unable to WRITE BOOTDATA TO SPI FLASH,"
+			       		" retry = %d \n", retry);
+			continue;
+		}
+		break;
+	}
+
+	if( retry <= 0 )
+		return -EFAULT;
+
+	retry = 5;
+	while(retry -- > 0) {
+		if (Sensor_flash_wp_enable(client) < 0) {
+			dev_err(&client->dev,
+		       		"Unable to ACCESS FLASH = %d \n", retry);
+			continue;
+		} 
+		break;
+	}
+			
+	if( retry <= 0 )
+		return -EFAULT;
+
+	msleep(200);
+	
+skip_bootdata_flash:
+
+#ifdef PROBE_STATUS
+	sprintf(probe_status_array[total_num_cam].spi_fw_status, "Completed");
+	probe_status_array[total_num_cam].spi_fw_status_percentage = 100;
+	probe_status_array[total_num_cam].percentage = 90;	
+#endif
+	return errcode;
+}
+
+/*
+ * This function is called while Loading the Driver
+ */
+static int ecam_probe(struct i2c_client *client,const struct i2c_device_id *id)
+{
+	int8_t errcode = ERRCODE_SUCCESS;
+	struct camera_common_data *common_data;
+	struct device_node *node = client->dev.of_node;
+	struct cam *priv;
+	uint8_t loop, retry;
+
+	uint8_t spi_flash_bootdata_changed = 0;
+
+	/*
+	 * Handling Load Switch to enable power to all modules
+	 */
+	if(!num_cam_probed)
+	{
+#ifdef LOAD_SWITCH	
+		if((set_load_switch_status("A", 0x1f))){
+			pr_info("Error Enabling Load Switch 1 Status");
+		}
+		if((set_load_switch_status("B", 0x1f))){
+			pr_info("Error Enabling Load Switch 2 Status");
+		}
+#endif
+	}
+	num_cam_probed++;
+
+	++prove_var_isx031_count;
+	memset(pid, 0x00, 8);
+	num_cam = 0;
+
+	if (!IS_ENABLED(CONFIG_OF) || !node){
+		errcode = -EINVAL;
+		goto exit;
+	}
+	
+	/* Allocating memories for required Data */
+	common_data = devm_kzalloc(&client->dev,
+				sizeof(struct camera_common_data), 
+							GFP_KERNEL);
+	if (!common_data){
+		errcode = -ENOMEM;
+		goto exit;
+	}
+
+	priv = devm_kzalloc(&client->dev, sizeof(struct cam) +
+		sizeof(struct v4l2_ctrl *) * MAX_NUM_CONTROLS ,
+			GFP_KERNEL);
+
+	if (!priv){
+		errcode = -ENOMEM;
+		goto exit;
+	}
+
+	/* Identify the connected Device */
+	priv->cam_id = id->driver_data;
+	
+	priv->probe_value_local = prove_var_isx031_count;
+
+#ifdef PROBE_STATUS
+	errcode = create_probe_sysfs_entries();
+	if(errcode){
+		pr_info("Unable to create probe sysfs entries");
+		/* 
+		 * Avoiding return to continue probning even if the 
+		 * creation of sysfs fails
+		 */
+	}
+#endif
+	
+	priv->pdata = cam_parse_dt(client);
+	if (!priv->pdata) {
+		dev_err(&client->dev, "Unable to parse data from dtb\n");
+		errcode = -EFAULT;
+		goto exit;
+	}
+
+	/* Gets e-con specific data from DTB */
+	errcode = ecam_specific_dt_parse(client, priv);
+       	if(errcode < 0){
+		dev_err(&client->dev, 
+			"Unable tp parse ecam specific data from dtb");
+		errcode = -EFAULT;
+		goto exit;
+	}
+
+	if(g_prev_connected_cam_id != priv->cam_id)
+		is_fw_loaded = 0;
+
+	/* Loading Fw from rootfs */
+	if(!is_fw_loaded){
+
+		if(ecam_mcu_firmware_load(client) < ERRCODE_SUCCESS){
+			dev_err(&client->dev,"failed to load mcu firmware\n");
+			errcode = -ENOENT;
+			goto exit;
+		}
+		else{
+			pr_info("Firmware Successfully read by driver\n");
+			is_fw_loaded = 1;
+		}
+	}
+	
+	mutex_init(&priv->mcu_i2c_mutex);
+		
+	/* Create's Sysfs Directory */
+	errcode = create_sysfs_dir(client, priv);
+
+	priv->i2c_client = client;
+	priv->s_data = common_data;
+	priv->subdev = &common_data->subdev;
+	priv->subdev->dev = &client->dev;
+	priv->s_data->dev = &client->dev;
+	common_data->priv = (void *)priv;
+
+	errcode = cam_power_get(priv);
+	if (errcode)
+		goto exit;
+
+	errcode = cam_power_on(common_data);
+	if (errcode)
+		goto exit;
+
+	errcode = max96712_serdes_config_init(client, priv);
+	if(errcode < ERRCODE_SUCCESS)
+	{
+		dev_err(&client->dev,"serdes_config_init_failed\n");
+		errcode = -EIO;
+		goto exit;
+	}
+
+#ifdef PROBE_STATUS
+	if(sysfs_probe_dir)
+		create_cam_specific_sysfs_entries(total_num_cam, priv->cam_id);
+#endif
+
+	/* Toggeling MCU RESET */
+	errcode = toggle_mcu_reset_pin(client, priv);
+	if(errcode)
+		goto exit;
+	
+	msleep(100);
+
+	if(priv->cam_id == ISX031)
+	{
+		/* ISX031 has seperate bootdata for ISP */
+		isx031_isp_bootdata_check(client, priv,&spi_flash_bootdata_changed);
+	}
+#ifdef PROBE_STATUS
+	probe_status_array[total_num_cam].percentage = 10;	
+#endif
+	/* Gets FW version and Update FW if required */
+	errcode = check_ecam_mcu_fw_status(client, priv, spi_flash_bootdata_changed);
+	if(errcode < 0){
+		dev_err (&client->dev, "%s(%d):ecam_mcu_fw_status Failed\n",
+				__func__, __LINE__);
+		goto exit;
+
+	}
+
+	if(priv->cam_id == ISX031)
+	{
+		errcode = isx031_chk_flash_and_isp_bootdata(client, priv, spi_flash_bootdata_changed);
+		if(errcode != ERRCODE_SUCCESS)
+		{
+#ifdef PROBE_STATUS
+			sprintf(probe_status_array[total_num_cam].spi_fw_status, "Error Updating SPI");
+			probe_status_array[total_num_cam].spi_fw_status_percentage = -1;
+#endif
+		}
+	}
+
+#ifdef PROBE_STATUS
+	probe_status_array[total_num_cam].percentage = 90;
+#endif
+
+	/* MCU Related Configurations */
+	errcode = mcu_configurations(client, priv);
+	if(errcode < 0){
+		dev_err(&client->dev, "Error in mcu Configurations(%d)",
+			__LINE__);
+	}
+
+	errcode = ecam_mcu_core_initialize(client, priv);
+	if(errcode < 0){
+		dev_err (&client->dev, "%s(%d):ecam MCU Init Failed\n",
+				__func__, __LINE__);
+		goto exit;
+	}
+
+	if(serdes_configuration(priv, client) < 0 ){
+		msleep(100);
+		dev_info(&client->dev,"serdes configuration \n");
+	}
+
+	for(loop = 0; loop < frm_fmt_size; loop++) {
+		priv->mcu_cam_frmfmt[loop].framerates = devm_kzalloc(&client->dev,
+			       		sizeof(int) * MAX_NUM_FRATES, GFP_KERNEL);
+		if(!priv->mcu_cam_frmfmt[loop].framerates) {
+			dev_err(&client->dev, "Unable to allocate memory \n");
+			errcode = -ENOMEM;
+			goto exit;
+		}
+	}
+
+	/* Enumerate Formats */
+	retry = 5;
+	while (--retry >= 0) {
+		if (mcu_list_fmts(client, priv->stream_info, 
+					&frm_fmt_size, priv) < 0) {
+			dev_err(&client->dev, "List Fmts failure.\
+				       			retrying\n");
+			continue;
+		} else {
+		  	break;
+		}
+	}
+
+	if (retry < 0) {
+	  	dev_err(&client->dev, "Unable to List Fmts. \n");
+	  	errcode =-EFAULT;
+		goto exit;
+	}
+
+	common_data->ops = NULL;
+	common_data->ctrl_handler = &priv->ctrl_handler;
+	common_data->frmfmt = priv->mcu_cam_frmfmt;
+	common_data->colorfmt =
+	camera_common_find_datafmt(DEFAULT_DATAFMT);
+	common_data->power = &priv->power;
+	common_data->ctrls = priv->ctrls;
+	common_data->priv = (void *)priv;
+	common_data->numctrls = priv->num_ctrls;
+	common_data->numfmts = frm_fmt_size;
+	common_data->def_mode = 0;
+	if(priv->cam_id == AR0821){
+		common_data->def_width = AR0821_DEFAULT_WIDTH;
+		common_data->def_height = AR0821_DEFAULT_HEIGHT;
+	}
+	else if(priv->cam_id == ISX031){
+		common_data->def_width = ISX031_DEFAULT_WIDTH;
+		common_data->def_height = ISX031_DEFAULT_HEIGHT;
+	}
+	common_data->fmt_width = common_data->def_width;
+	common_data->fmt_height = common_data->def_height;
+	common_data->def_clk_freq = 24000000;
+
+	priv->i2c_client = client;
+	priv->s_data = common_data;
+	priv->subdev = &common_data->subdev;
+	priv->subdev->dev = &client->dev;
+	priv->s_data->dev = &client->dev;
+	priv->prev_index = 0xFFFE;
+
+	errcode = camera_common_initialize(common_data, 
+			"ecam_yuv");
+	if (errcode) {
+		dev_err(&client->dev, "Failed to initialize ecam_yuv.\n");
+		goto exit;
+	}
+
+	v4l2_i2c_subdev_init(priv->subdev, client, &cam_subdev_ops);
+
+	errcode = cam_ctrls_init(priv, priv->mcu_ctrl_info);
+	if (errcode)
+		goto exit;
+
+	priv->subdev->internal_ops = &cam_subdev_internal_ops;
+	priv->subdev->flags |=
+		V4L2_SUBDEV_FL_HAS_DEVNODE | V4L2_SUBDEV_FL_HAS_EVENTS;
+	
+	/*
+	   To unload the module driver module, 
+	   Set (struct v4l2_subdev *)priv->subdev->sd to NULL.
+	   Refer tegracam_v4l2subdev_register() in tegracam_v4l2.c
+	 */
+	if (priv->subdev->owner == THIS_MODULE) {
+		common_data->owner = priv->subdev->owner;
+		priv->subdev->owner = NULL;
+	} else {
+		// It shouldn't come here in probe();
+		;
+	}
+
+#if defined(CONFIG_MEDIA_CONTROLLER)
+	priv->pad.flags = MEDIA_PAD_FL_SOURCE;
+	priv->subdev->entity.ops = &cam_media_ops;
+	errcode = tegra_media_entity_init(&priv->subdev->entity, 1, 
+						&priv->pad, true, true);
+	if (errcode < ERRCODE_SUCCESS) {
+		dev_err(&client->dev, "unable to init media entity\n");
+		goto exit;
+	}
+#endif
+
+	errcode = v4l2_async_register_subdev(priv->subdev);
+	if (errcode)
+		goto exit;
+		
+	if(client->adapter->nr == 9){
+		dser1_ser_status = ser_status;
+	}
+	else{
+		dser2_ser_status = ser_status;
+	}
+
+	if(priv->cam_id == ISX031)
+	{
+		if(!is_sysfs_dir_xerror){
+			pr_info("Creating Xerror sysfs directory");
+			/*Creating a directory in /sys/kernel/ */
+			kobj_ref_xerror = 
+				kobject_create_and_add("xerror_file",kernel_kobj);
+
+			/*Creating sysfs file for etx_value*/
+			if(sysfs_create_file(kobj_ref_xerror,
+				&get_pid_from_application_attribute.attr)){
+				pr_err("Cannot create sysfs file......\n");
+				// goto r_sysfs;
+			}
+			is_sysfs_dir_xerror = 1;
+		}
+
+	}
+	
+	if(priv->cam_id == AR0821)
+	{
+		ar0821_num_cam++;
+		cam_track_day_hdr++;
+		is_all_cam_changed = 1;
+		priv->trigger_mode = 1;	
+		
+		/* Handled Throughput */
+		retry = 5;
+		while(retry-- > 0)
+		{
+			if(g_max_cam == EIGHT_CAM) {
+				errcode = sensor_isp_write(client, 
+					AR0821_THROUGHPUT_LIMIT_REG, 0x43FF);
+			}
+			else {
+				errcode = sensor_isp_write(client, 
+						AR0821_THROUGHPUT_LIMIT_REG, 0x8CA0);
+			}
+			if(!errcode)
+				break;
+		}
+
+		if(retry <= 0)
+		{	
+			dev_err(&client->dev, 
+				"Error in Writing ThroughtPut Registers");
+			errcode = -EINVAL;
+			goto exit;
+		}
+	}
+
+	if(priv->cam_id == AR0821)
+		dev_info(&client->dev, "Detected AR0821 Sensor\n");
+	else if(priv->cam_id == ISX031){
+		priv->probe_value_local = prove_var_isx031_count;	
+		dev_info(&client->dev, "Detected ISX031 Sensor\n");
+	}
+	else if(priv->cam_id == AR0234)
+		dev_info(&client->dev, "Detected AR0234 Sensor\n");
+
+#ifdef PROBE_STATUS
+	sprintf(probe_status_array[total_num_cam].status, "Probed");
+	probe_status_array[total_num_cam].percentage = 100;
+#endif
+	total_num_cam++;
+	total_cam_probed++;
+exit:
+	dev_err(&client->dev," ser_status=%x\n",ser_status);
+	if(serdes_write_16b_reg(client, 
+			priv->dser_addr, MAX96712_LINK_REG, ser_status) < 0)
+	{
+		dev_err (&client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		errcode = -EIO;
+	}
+
+	/* Storing previous cam_id */
+	g_prev_connected_cam_id = priv->cam_id;	
+
+	if(num_cam_probed == 8)
+	{
+#ifdef PROBE_STATUS
+		sprintf(probe_status_str, "Completed");
+#endif
+
+#ifdef LOAD_SWITCH
+		if((set_load_switch_status("A", dser1_ser_status))){
+			pr_info("Error Enabling Load Switch 1 Status");
+		}
+		if((set_load_switch_status("B", dser2_ser_status))){
+			pr_info("Error Enabling Load Switch 2 Status");
+		}
+#endif
+	}
+
+#ifdef PROBE_STATUS
+	if(errcode != ERRCODE_SUCCESS)
+	{
+		sprintf(probe_status_array[total_num_cam].status, "Error Probing Camera");
+		probe_status_array[total_num_cam].percentage = -1;
+	}
+#endif
+
+	return errcode;
+}
+
+static int ecam_remove(struct i2c_client *client)
+{
+	uint8_t errcode = ERRCODE_SUCCESS;
+	
+	struct camera_common_data *s_data = to_camera_common_data(&client->dev);
+	struct cam *priv = (struct cam *)s_data->priv;
+	struct device_node *node = client->dev.of_node;
+	int loop = 0;
+	int trigger_gpio = 0;
+	prove_var_isx031_count = 0;
+	priv->priv_pid = 0;
+
+	if (!priv || !priv->pdata)
+		return -1;
+
+	if( priv->kthread_xerror_start )	
+		kthread_stop(priv->kthread_xerror_start);
+
+	v4l2_async_unregister_subdev(priv->subdev);
+#if defined(CONFIG_MEDIA_CONTROLLER)
+	media_entity_cleanup(&priv->subdev->entity);
+#endif
+
+	if(priv->phy == PHY_B || priv->phy == PHY_C || priv->phy == PHY_D){
+		if(serdes_write_16b_reg(client, priv->ser_reassigned_addr, 
+						0x0000, priv->ser_def_addr<<1) < 0)
+		{
+			dev_err (&client->dev, "%s(%d): Failed\n",
+					__func__, __LINE__);
+			return -EIO;
+		}
+		msleep(100);
+	}
+
+	if(num_cam_probed == 8)
+	{
+#ifdef LOAD_SWITCH
+		if((set_load_switch_status("A", 0x1f))){
+			pr_info("Error Enabling Load Switch 1 Status");
+		}
+		if((set_load_switch_status("B", 0x1f))){
+			pr_info("Error Enabling Load Switch 2 Status");
+		}
+#endif
+	}
+	num_cam_probed--;
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+	cam_power_put(priv);
+	camera_common_remove_debugfs(s_data);
+
+	mutex_destroy(&priv->mcu_i2c_mutex);
+	
+	remove_sysfs_dir();
+
+	if(is_sysfs_dir_xerror){
+		pr_info("Removing Xerror Sysfs files");
+		kobject_put(kobj_ref_xerror);
+ 		sysfs_remove_file(kernel_kobj, &get_pid_from_application_attribute.attr);
+		is_sysfs_dir_xerror = 0;
+		pr_info("Removed Xerror Sysfs files");
+	}
+
+	if(is_fw_loaded == 1){
+
+		release_firmware(mcu_fw);
+
+		if( mcu_fw_buf != NULL )
+		{
+			pr_info("Freeing mcu_fw_buf");
+			kfree(mcu_fw_buf);
+		}
+		is_fw_loaded = 0;
+		pr_info("Firmware Released by the Driver");
+	}
+	
+	if(sysfs_probe_dir){	
+		pr_info("Removing Probe Sysfs files");
+		kobject_put(kobj_ref_probe);
+		for(loop = 0; loop < total_num_cam; loop++)
+		{
+			kobject_put(kobj_ref_probe_cam[loop]);
+		}
+		sysfs_probe_dir = 0;
+	}
+
+	if(priv->cam_id == ISX031)
+	{
+		PHY_AB_D1 = 0;
+		PHY_CD_D1 = 0;
+		PHY_A_60FPS_D1 = 0;
+		PHY_B_60FPS_D1 = 0;
+		PHY_C_60FPS_D1 = 0;
+		PHY_D_60FPS_D1 = 0;
+
+		PHY_AB_D2 = 0;
+		PHY_CD_D2 = 0;
+		PHY_A_60FPS_D2 = 0;
+		PHY_B_60FPS_D2 = 0;
+		PHY_C_60FPS_D2 = 0;
+		PHY_D_60FPS_D2 = 0;	
+
+	}
+	/* Free up memory */
+	for(loop = 0; 
+		loop < priv->mcu_ctrl_info->ctrl_ui_data.ctrl_menu_info.num_menu_elem
+			; loop++) {
+		FREE_SAFE(&client->dev,
+			priv->mcu_ctrl_info->ctrl_ui_data.ctrl_menu_info.menu[loop]);
+	}
+
+	FREE_SAFE(&client->dev, 
+		priv->mcu_ctrl_info->ctrl_ui_data.ctrl_menu_info.menu);
+
+	FREE_SAFE(&client->dev, priv->mcu_ctrl_info);
+
+	for(loop = 0; loop < s_data->numfmts; loop++ ) {
+		FREE_SAFE(&client->dev, 
+			(void *)priv->mcu_cam_frmfmt[loop].framerates);
+	}
+
+	FREE_SAFE(&client->dev, priv->mcu_cam_frmfmt);
+
+	FREE_SAFE(&client->dev, priv->ctrldb);
+	FREE_SAFE(&client->dev, priv->streamdb);
+
+	FREE_SAFE(&client->dev, priv->stream_info);
+	FREE_SAFE(&client->dev, fw_version);
+	FREE_SAFE(&client->dev, priv->pdata);
+	FREE_SAFE(&client->dev, priv->s_data);
+	FREE_SAFE(&client->dev, priv);
+
+
+	dev_info(&client->dev, "rmmod success for YUV GMSL Cameras\n");
+	return errcode;
+}
