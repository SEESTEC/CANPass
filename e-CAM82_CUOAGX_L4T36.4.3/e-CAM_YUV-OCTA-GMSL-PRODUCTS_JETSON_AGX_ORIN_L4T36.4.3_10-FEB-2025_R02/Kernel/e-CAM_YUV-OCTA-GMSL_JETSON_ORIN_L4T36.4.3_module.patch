+int toggle_mcu_reset_pin(struct i2c_client *client, struct cam *priv)
+{
+
+	if(serdes_write_16b_reg(client, priv->ser_reassigned_addr,
+			       	priv->reset_reg , 0x40 ) < 0)
+	{
+		dev_err (&client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(1);
+	if(serdes_write_16b_reg(client, priv->ser_reassigned_addr,
+				priv->reset_reg , 0x98 ) < 0)
+	{
+		dev_err (&client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(1);
+	return 0;	
+}
