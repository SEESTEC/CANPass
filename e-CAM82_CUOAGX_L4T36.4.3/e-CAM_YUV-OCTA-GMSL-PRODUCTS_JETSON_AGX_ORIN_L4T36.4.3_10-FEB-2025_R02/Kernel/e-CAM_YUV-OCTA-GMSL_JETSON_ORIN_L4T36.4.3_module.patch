+int mcu_err_handle(struct econ_stream_monitor *err_cam,
+	       	uint8_t err_handle)
+{
+	int err = 0, ret = 0;
+	uint16_t sensor_id = 0;
+	uint8_t retry = 0, reg_val=0;
+	uint8_t fl_cn_status, lp_pa_status, nv_bt_status = 0;
+	unsigned char fw_version[32] = {0}, txt_fw_version[32] = {0};
+	/* MCU Reset */
+	while(retry++ < 10 && err_handle){
+		pr_info("Performing MCU Reset");
+		if(toggle_mcu_reset_pin(err_cam->client,
+				     err_cam->cam) <  ERRCODE_SUCCESS)
+		{
+			msleep(100);
+			continue;
+		}
+		break;
+	}
+	while(retry >= 10)
+		return -EIO;
+
+	msleep(100);
+
+	retry = 0;
+	while(retry++ < 5)
+	{
+		ret = mcu_get_fw_version(err_cam->client, fw_version, txt_fw_version);
+		if(ret == 0)
+			break;
+	}
+	if (ret != ERRCODE_SUCCESS) {
+		pr_info("MCU Chip Not detected \n");
+		return -EIO;
+	}
+	else {
+		pr_info("Detected MCU and Current FW Version - (%.32s)",
+							fw_version);
+	}
+	msleep(100);	
+
+	//pr_info("Going to get Sensor ID\n");
+
+	if (mcu_get_sensor_id(err_cam->client, &sensor_id) < 0) {
+		dev_err(&err_cam->client->dev,
+			       	"Unable to get MCU Sensor ID \n");
+		if(!err_handle)
+			return -EIO;
+	}
+	dev_info(&err_cam->client->dev,"Sensor ID = 0x%x\n",sensor_id);
+
+	if(err_cam->cam->cam_id == AR0821)
+	{
+		/* 
+		 * Using INIT_ON_BOOT in MCU, No Configurations required 
+		 */
+#if 0
+		if(err_handle){
+			if(mipi_sensor_mipi_config(err_cam->client,
+					err_cam->cam,CMD_ID_LANE_CONFIG) < 0){
+				pr_info("MIPI Lane Config failed \n");
+			}
+			else {
+				pr_info("MIPI Lane Config Sucess");
+			}
+		
+			if(mipi_sensor_mipi_config(err_cam->client,
+					err_cam->cam,CMD_ID_MIPI_CLK_CONFIG) < 0) {
+				pr_info("MIPI CLK Config failed \n");
+			}
+			else {
+				pr_info("MIPI CLK Config Sucess");
+			}
+		}
+#endif
+	}
+	if(!err_handle)
+		return 0;
+
+	pr_info("Re-Initializing the MCU\n");
+	retry = 10;
+	while(retry-- > 0) {
+		if (mcu_isp_init(err_cam->client) < 0) {
+			dev_err(&err_cam->client->dev,
+				  "Unable to INIT ISP, retry = %d \n", retry);
+			continue;
+		} 
+		else{
+			break;
+		}
+	}
+
+	if(err_cam->cam->cam_id == ISX031)
+	{
+		retry = 0;
+		while(retry++ < 5){
+			err = mcu_get_flash_connect_status(err_cam->client, &fl_cn_status);
+			if(err != 0){
+				dev_err(&err_cam->client->dev, 
+					"Retrying to get FLASH CONNECT STATUS !..\n");
+				/* Handling in case of ACK Failure */
+				if(err == ERRCODE_AGAIN)
+				{
+					pr_info("Setting ACK Response Mode");
+					set_ack_response_mode(err_cam->client);
+					/* 
+					 * Providing One Frame time 
+					 * delay after Stream On 
+					 */
+					msleep(50);
+				}
+				continue;
+			}
+			else
+				break;
+		}
+
+		if(retry > 5){
+			dev_err(&err_cam->client->dev, 
+				"Unable to get fl Connect STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&err_cam->client->dev,
+			"Fl Connect Status = 0x%02x\n",fl_cn_status);
+
+		if(fl_cn_status != 0x01)
+		{
+			pr_info("FLASH Device is Corrupted");
+			return -EIO;
+		}
+
+		msleep(1);
+
+		retry = 0;
+		while(retry++ < 5){
+		if (mcu_get_load_param_status(err_cam->client, &lp_pa_status) < 0) {
+			dev_err(&err_cam->client->dev, 
+				"Unable to get Load Param STATUS!.. Retrying..\n");
+			continue;
+		}
+		else
+			break;
+		}
+		if(retry > 5){
+			dev_err(&err_cam->client->dev, 
+				"Unable to get Load Param STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&err_cam->client->dev,"Load Param Status = 0x%02x\n",lp_pa_status);
+
+		if(lp_pa_status != 0x01)
+		{
+			pr_info("The sensor does not load the Serial NOR Flash device"
+			       " at sensor startup");
+			return -EIO;
+		}
+	
+		msleep(1);
+
+		retry = 0;
+		while(retry++ < 5){
+		if (mcu_get_nv_boot_status(err_cam->client, &nv_bt_status) < 0) {
+			dev_err(&err_cam->client->dev, 
+				"Unable to get NV Boot STATUS!.. Retrying..\n");
+			continue;
+		}
+		else
+			break;
+		}
+		if(retry > 5){
+			dev_err(&err_cam->client->dev, 
+				"Unable to get NV Boot STATUS!.. Exiting..\n");
+			return -EIO;
+		}
+		dev_info(&err_cam->client->dev,"NV BOOT  Status = 0x%02x\n",nv_bt_status);
+	
+		if(nv_bt_status != 0x01)
+		{
+			pr_info("A load operation from Flash is unsuccessful");
+			return -EIO;
+		}
+	}
+
+	/* Stream Config */
+	err = gen_mcu_stream_config(err_cam->client, err_cam->cam);
+	if(err < ERRCODE_SUCCESS){
+		pr_info("\nError in stream configure \n");
+		return -EIO;
+	}
+
+	return 0;
+}	
+
+int reconfigure_serializer(struct econ_stream_monitor *err_cam)
+{
+
+	/* Configuring SIOA Serializer */
+	if(err_cam->cam->phy == PHY_A)
+	{
+		if(serdes_parse_regdata(err_cam->client, SER1_I2C_CONF,
+			ser1_i2c_array_size,
+				err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOA Ser\n",
+								__func__);
+			return -EIO;
+		}
+
+		if(serdes_parse_regdata(err_cam->client, SER1_CONF,
+			ser1_array_size,
+				err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOA Ser\n",
+								__func__);
+			return -EIO;
+		}
+
+		pr_info("configuring SIOA serializer"
+			       			" successful\n");
+	}
+	/* Configuring SIOB Serializer */
+	else if(err_cam->cam->phy == PHY_B)
+	{
+		if(serdes_parse_regdata(err_cam->client, SER2_I2C_CONF,
+			ser2_i2c_array_size,
+				err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOA Ser\n",
+							__func__);
+			return -EIO;
+		}
+		if(serdes_parse_regdata(err_cam->client, SER2_CONF,
+			ser2_array_size,
+				err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOA Ser\n",
+							__func__);
+			return -EIO;
+		}
+		pr_info("configuring SIOB serializer"
+				       		" successful\n");
+	}
+	/* Configuring SIOC Serializer */
+	else if(err_cam->cam->phy == PHY_C)
+	{
+		if(serdes_parse_regdata(err_cam->client, 
+			SER3_I2C_CONF,ser3_i2c_array_size,
+			       	err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev, 
+				"%s: Failed to configure SIOC Ser\n",	
+							__func__);
+			return -EIO;
+		}
+		if(serdes_parse_regdata(err_cam->client, 
+			SER3_CONF,ser3_array_size,
+			       	err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev, 
+				"%s: Failed to configure SIOC Ser\n",	
+							__func__);
+			return -EIO;
+		}
+
+		pr_info("configuring SIOC serializer"
+			       			" successful\n");
+	}
+	/* Configuring SIOD Serializer */
+	else if(err_cam->cam->phy == PHY_D)
+	{
+		if(serdes_parse_regdata(err_cam->client, 
+			SER4_I2C_CONF,ser4_i2c_array_size,
+		       		err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOD Ser\n",
+							__func__);
+			return -EIO;
+		}
+		if(serdes_parse_regdata(err_cam->client, 
+			SER4_CONF,ser4_array_size,
+		       		err_cam->cam->ser_reassigned_addr) < 0) {
+			dev_err(&err_cam->client->dev,
+				"%s: Failed to configure SIOD Ser\n",
+							__func__);
+			return -EIO;
+		}
+
+		pr_info("configuring SIOD serializer"
+			       			" successful\n");
+	}	
+
+	/*Set Boot pin low*/
+	if((serdes_write_16b_reg(err_cam->client, 
+			err_cam->cam->ser_reassigned_addr, 0x02BE, 0x40)) < 0)
+	{
+		dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(10);
+
+	if((serdes_write_16b_reg(err_cam->client, 
+			err_cam->cam->ser_reassigned_addr, 0x02CD, 0x40)) < 0)
+	{
+		dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(10);
+
+
+	/*Trigger Pin mapping*/
+	if((serdes_write_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr, 0x02D3, 0xC4)) < 0)
+	{
+		dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(10);
+
+	/* Setting CAM to MASTER_MODE */
+	if((serdes_write_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr, 0x02D6, 0x40)) < 0)
+	{
+		dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+		return -EIO;
+	}
+	msleep(10);
+
+	if(err_cam->cam->cam_id == AR0234)
+	{
+		/* Trigger Mapping for AR0234 */
+		//pr_info("\n<< trigger pin mapping for ar0234>>\n");
+
+		if((serdes_write_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr, 0x02C7, 0xC4)) < 0)
+		{
+			dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+					__func__, __LINE__);
+			return -EIO;
+		}
+
+		if((serdes_write_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr, 0x02C9, 0x4A)) < 0)
+		{
+			dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+					__func__, __LINE__);
+			return -EIO;
+		}
+
+	}
+
+	return 0;
+
+}
+
+int serializer_reassignment(struct econ_stream_monitor *err_cam)
+{
+
+	uint8_t retry = 0, ret_val = 0;
+	uint8_t reg_val = 0;
+	uint8_t link_enable_val;
+
+	while(retry++ < 5)
+	{	
+		if((serdes_read_16b_reg(err_cam->client, err_cam->cam->ser_def_addr,
+					DEV_ADDR_REG, &reg_val)) < 0)
+		{
+			dev_err (&err_cam->client->dev,
+				"%s(%d): Could not Detect"
+			       		"the Serializer Chip\n",
+						__func__, __LINE__);
+			continue;
+		}
+
+		if(reg_val >> 1 == err_cam->cam->ser_def_addr)
+		{
+			if((serdes_write_16b_reg(err_cam->client, err_cam->cam->ser_def_addr,
+				DEV_ADDR_REG, err_cam->cam->ser_reassigned_addr << 1)) < 0)
+			{
+				dev_err (&err_cam->client->dev,
+					"%s(%d): Failed \n",__func__, __LINE__);
+				continue;
+			}
+			
+			if((serdes_read_16b_reg(err_cam->client, 
+					err_cam->cam->ser_reassigned_addr,DEV_ADDR_REG, &reg_val)) < 0)
+			{
+				dev_err (&err_cam->client->dev,
+					"%s(%d): Failed \n",__func__,
+			       					__LINE__);
+				continue;
+			}
+
+			if(reg_val >> 1 == err_cam->cam->ser_reassigned_addr)
+			{
+				pr_info("I2C re-assignment detected\n");
+				pr_info("Serializer Chip is present @addr = %02x\n",
+				       				reg_val >> 1);
+				break;
+			}
+		}
+	}
+	
+	msleep(10);
+
+	if(retry >= 5)
+		return -EIO;
+	
+	ret_val = reconfigure_serializer(err_cam);
+
+	if(ret_val != 0)
+		return ret_val;	
+
+	retry = 0;
+	while(retry++ < 5)
+	{
+		if((serdes_read_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr,X_PIPE_PCLKDET_REG,
+				&reg_val)) < 0)
+		{
+			dev_err (&err_cam->client->dev, 
+				"%s:Error in Serializer read\n",
+					__func__);
+			continue;
+		}
+		if(reg_val & 0x80){
+			pr_info(" Detected PCLKDET in Serializer\n");
+			return ERRCODE_SUCCESS;
+		}
+	}
+	dev_err (&err_cam->client->dev,
+		"Pixclock not detected in Serializer\n"
+			"Need to reconfigure the MCU so Exiting...!\n");
+	return -EIO;
+
+}
+
+int ser_err_handler(struct econ_stream_monitor *err_cam, uint8_t *link_enable_val, uint8_t err_handle)
+{
+	uint8_t reg_val = 0, ret_val = 0;
+	uint8_t retry = 0;
+
+	if(err_handle)
+	{	
+		if(err_cam->cam->phy == PHY_A)
+			*link_enable_val = EN_LINK_A;
+		if(err_cam->cam->phy == PHY_B)
+			*link_enable_val = EN_LINK_B;
+		if(err_cam->cam->phy == PHY_C)
+			*link_enable_val = EN_LINK_C;
+		if(err_cam->cam->phy == PHY_D)
+			*link_enable_val = EN_LINK_D;
+	
+
+		/* Enabling Error Camera Link */
+		if((serdes_write_16b_reg(err_cam->client, 
+			err_cam->cam->dser_addr,
+				LINK_REG, *link_enable_val)) < 0) 
+		{
+			dev_err (&err_cam->client->dev, "%s(%d): Failed \n",
+				__func__, __LINE__);
+		}
+
+		/* 
+		 * Reading the Address of the Serializer at re-assigned address 
+		 * to check the re-assignment
+		 */	
+		if((serdes_read_16b_reg(err_cam->client, err_cam->cam->ser_reassigned_addr,
+					DEV_ADDR_REG, &reg_val)) < 0)
+		{
+			pr_info("I2C Re-assignment Not Detected in the Serialzier");
+			return -ENODEV;
+		}
+
+		if( (reg_val >> 1) == err_cam->cam->ser_reassigned_addr )
+		{
+			pr_info("I2C Re-assignment is Detected in the serialzier");
+		}
+	}
+
+	while(retry++ < 5)
+	{
+		if((serdes_read_16b_reg(err_cam->client,
+			err_cam->cam->ser_reassigned_addr,X_PIPE_PCLKDET_REG,
+				&reg_val)) < 0)
+		{
+			dev_err (&err_cam->client->dev, 
+				"%s:Error in Serializer read\n",
+					__func__);
+			continue;
+		}
+		if(reg_val & 0x80){
+			pr_info(" Detected PCLKDET in Serializer\n");
+			return ERRCODE_SUCCESS;
+		}
+	}
+	dev_err (&err_cam->client->dev,
+		"Pixclock not detected in Serializer\n"
+			"Need to reconfigure the MCU so Exiting...!\n");
+	return -EIO;
+}
+
+int dser_video_lock_status(struct econ_stream_monitor *err_cam)
+{
+	uint8_t retry = 5, video_dtckt = 0;
+	uint8_t ret_val = 0, reg_val = 0;
+	uint16_t reg_addr;
+
+	/* Assign reg_addr of VIDEO_LOCK according to PHY_x */
+	if(err_cam->cam->phy == PHY_A){
+		reg_addr = VIDEO_LOCK_A;
+	}
+	else if(err_cam->cam->phy == PHY_B){
+		reg_addr = VIDEO_LOCK_B;
+	}
+	else if(err_cam->cam->phy == PHY_C){
+		reg_addr = VIDEO_LOCK_C;
+	}
+	else if(err_cam->cam->phy == PHY_D){
+		reg_addr = VIDEO_LOCK_D;
+	}
+
+	/* Checking the video lock in the Deserializer */
+	while(retry--)
+	{
+		if((serdes_read_16b_reg(err_cam->client, err_cam->cam->dser_addr,
+			reg_addr, &video_dtckt)) < 0)
+		{
+			dev_err (&err_cam->client->dev,
+				"%s(%d): Failed \n",
+					__func__, __LINE__);
+			continue;
+		}
+		if(video_dtckt & 0x01){
+			pr_info("Detected Video Lock in Deserializer");
+			return ERRCODE_SUCCESS;
+		}
+	}
+
+	pr_info("Video Lock is not Detected in Deserializer");
+	return -EIO;
+}
+
+int get_specific_link_lock_status(struct econ_stream_monitor *err_cam,
+		uint16_t link_status_addr)
+{
+	uint8_t reg_val = 0;
+	if((serdes_read_16b_reg(err_cam->client, err_cam->cam->dser_addr,
+					link_status_addr, &reg_val)) < 0)
+	{
+		dev_err (&err_cam->client->dev, "%s(%d): Failed\n",
+				__func__, __LINE__);
+	}
+	if(reg_val & 0x08)
+	{
+		return 0;
+	}
+	return -EIO;
+}
+
+int serdes_chip_status(struct econ_stream_monitor *err_cam)
+{
+	uint8_t reg_val=0, retry=5;
+
+	while(retry--)
+	{
+		/* 
+		 * Reading the Address of the Deserializer 
+		 * to check its Availability 
+		 */
+		if((serdes_read_16b_reg(err_cam->client,
+			err_cam->cam->dser_addr,DEV_ADDR_REG, &reg_val)) < 0)
+		{
+			dev_err (&err_cam->client->dev,
+				"%s(%d):Deserializer not detected"
+		      			"Check it's connection\n",
+						__func__, __LINE__);
+			continue;
+		}
+		pr_info("Deserializer Chip is "
+				"present @addr = %02x \n",reg_val >> 1);
+
+		/* 
+		 * Checking the Link Lock for the error cam serializer 
+		 * to check the serialzier availabiltiy 
+		 */
+		if(err_cam->cam->phy == PHY_A)
+		{
+			if((get_specific_link_lock_status(err_cam,
+						LINK_LOCK_A_REG)) == 0)
+				goto dser_success;
+			else
+				continue;
+		}
+		else if(err_cam->cam->phy == PHY_B)
+		{
+			if((get_specific_link_lock_status(err_cam,
+						LINK_LOCK_B_REG)) == 0)
+				goto dser_success;
+			else
+				continue;
+		}
+		else if(err_cam->cam->phy == PHY_C)
+		{
+			if((get_specific_link_lock_status(err_cam,
+						LINK_LOCK_C_REG)) == 0)
+				goto dser_success;
+			else
+				continue;
+		}
+		else if(err_cam->cam->phy == PHY_D)
+		{
+			if((get_specific_link_lock_status(err_cam,
+						LINK_LOCK_D_REG)) == 0)
+				goto dser_success;
+			else
+				continue;
+		}
+	}
+
+	pr_info("GMSL Link lock not detected");
+	return -ENODEV;
+
+dser_success:
+	pr_info("Detected link lock in the Deserializer");
+	return 0;
+
+}
+
+int dser_err_handler(struct econ_stream_monitor *err_cam)
+{
+	int8_t ret_val = 0;
+
+	/*
+	 * Checking the Deserialzier presence and 
+	 * Link Lock in the Deserializer
+	 */
+	ret_val = serdes_chip_status(err_cam);
+	if(ret_val){
+		pr_info("check power/cable connection of serializer");
+		ret_val = -ENODEV;
+		goto dser_err;
+	}
+
+	/*
+	 * Checking the VIDEO_LOCK status in Deserialzier
+	 */
+	ret_val = dser_video_lock_status(err_cam);
+
+dser_err:
+	return ret_val;
+}
+
+int8_t find_err_cam(char *err_cam_name)
+{
+	uint8_t loop = 0;
+
+	for(loop = 0; loop < total_num_cam; loop++)
+	{
+		if(!(strcmp(err_cam_name, 
+			dev_name_comp[loop])))
+		{
+			pr_info("Error Causing Camera = CAM-%d",loop);
+			return loop;
+		}
+	}
+	return -ENODEV;
+
+}
+
+int stream_monitor_thread(void *strm_dev)
+{
+	int8_t ret_val = 0, reset = 0;
+	uint8_t err_cam = 0, retry = 0, link_enable_val = 0; 
+	uint8_t is_err_handle_in_progress = 0;
+	uint8_t is_isp_sensor_err_handle_in_progress = 0;
+
+	uint8_t fl_cn_status, lp_pa_status, nv_bt_status = 0;
+
+	while(1)
+	{
+		wait_event_interruptible(econ_err_hand_q, 
+			((econ_frame_err_track == 1 \
+				|| is_stop_strm_mon_thread) \
+			 			&& ecam_status_check));
+		{
+			if(is_stop_strm_mon_thread)
+			{
+				pr_info("Thread returned");
+				is_stop_strm_mon_thread = 0;
+				return 0;
+			}
+
+			/* Getting err_cam number from vi */
+			err_cam = vi5_err_cam_num;
+			pr_info("Error Causing Camera is CAM-%d", err_cam);
+			
+			if(!is_isp_sensor_err_handle_in_progress)
+			{
+				/* 
+				 * Checks Link Lock & Video Lock Status
+				 * in Deserializer
+				 */
+				ret_val = dser_err_handler(strm_mon[err_cam]);
+				if(!ret_val)
+					goto reconfig_dser;
+				if(ret_val == -ENODEV)
+					goto reset_flags;
+				
+				/* 
+				 * Checks for PCLK in Serializer and handles
+				 * i2c_reassignment and translation
+				 */
+				ret_val = ser_err_handler(strm_mon[err_cam], &link_enable_val, 1);
+				if(!ret_val)
+				{
+					goto reconfig_ser;
+				}
+				else{
+					pr_info("Performing I2C Reassignment");
+					ret_val = serializer_reassignment(strm_mon[err_cam]);
+					if(!ret_val)
+						continue;
+				}
+			}
+
+			/* 
+			 * Detects MCU and Re-init
+			 */
+			ret_val = mcu_err_handle(strm_mon[err_cam], 1);
+			if(ret_val < 0){
+				pr_info("Error in MCU"
+					" Skipping Error Recovery");
+				goto reset_flags;
+			}
+reconfig_ser:
+
+			if(!is_isp_sensor_err_handle_in_progress)
+			{
+				ret_val = reconfigure_serializer(strm_mon[err_cam]);	
+				if(ret_val < 0)
+					goto reset_flags;
+
+reconfig_dser:
+				ret_val = reconfigure_deserializer(strm_mon[err_cam]);
+				if(ret_val < 0)
+					goto reset_flags;
+			}
+
+			ret_val = gen_mcu_stream_config(strm_mon[err_cam]->client, strm_mon[err_cam]->cam);
+			if(ret_val < ERRCODE_SUCCESS){
+				pr_info("\nError in stream configure \n");
+				goto reset_flags;
+			}
+
+			is_isp_sensor_err_handle_in_progress++;
+
+			/*
+			 * Checks ISP and Sensor's Streaming State
+			 * and frame count
+			 */
+			ret_val = isp_sensor_err_handle(strm_mon[err_cam]);
+			if(ret_val){
+				pr_info("Error in isp/sensor frame count");
+				if(reset)
+				{
+					pr_info("Error in ISP/Sensor");
+					goto reset_flags;
+				}
+#ifdef LOAD_SWITCH
+				else if(is_isp_sensor_err_handle_in_progress == 3)
+				{
+					pr_info("Reseting Power for the Error Camera "
+						       "and Retrying to recover");
+
+					if(strm_mon[err_cam]->client->adapter->nr == 9)
+					{
+						if(set_load_switch_status("A", 
+								(dser1_ser_status ^ link_enable_val)))
+							goto error_power_reset;
+
+						msleep(2000);
+
+						if(set_load_switch_status("A", dser1_ser_status))
+							goto error_power_reset;
+					}
+					else
+					{
+						if(set_load_switch_status("B", 
+								(dser2_ser_status ^ link_enable_val)))
+							goto error_power_reset;
+
+						msleep(2000);
+					
+						if(set_load_switch_status("B", dser2_ser_status))
+							goto error_power_reset;
+					}
+					is_isp_sensor_err_handle_in_progress = 0;
+					reset = 1;
+					continue;
+error_power_reset:
+					pr_info("Error Resetting Power to the camera");
+					goto reset_flags;
+				}
+#endif
+#ifndef LOAD_SWITCH
+				else if(is_isp_sensor_err_handle_in_progress == 3)
+				{
+					reset = 1; 
+					pr_info("Error in ISP/Sensor Recovery");
+					goto reset_flags;
+				}
+#endif
+				else
+					continue;
+			}
+
+reset_flags:
+
+			if(strm_mon[err_cam]->cam->cam_id == ISX031)
+			{
+				/* SENSOR RESET CHECK */
+				// SER:GPIO8 ---> SEN:GPIO0
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02D6, 0x98)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+							__func__, __LINE__);
+				}
+			
+				// SER:GPIO7 ---> SEN:GPIO1
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02D3, 0x40)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+	
+
+				// SER:GPIO3 ---> SEN:GPIO2
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02C7, 0x40)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+	
+				// SER : XERROR PIN HIGH
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02CD, 0x98)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+
+				// Trigger Mapping for E2 Rev
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02D3, 0xC4)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+
+
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02D5, 0x4A)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+			}
+			else if(strm_mon[err_cam]->cam->cam_id == AR0821)
+			{
+				/* Trigger Mapping for AR0821 */
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02C7, 0xC4)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02C8, 0x40)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->ser_reassigned_addr, 0x02C9, 0x4A)) < 0)
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed\n",
+						__func__, __LINE__);
+				}
+			}	
+
+			if(strm_mon[err_cam]->cam->cam_id == AR0821)
+			{
+
+				pr_info("Handling Throughput\n");
+				/* Handled Throughput */
+				retry = 5;
+				while(retry > 0)
+				{
+					if(g_max_cam == 8) {
+						ret_val = sensor_isp_write(strm_mon[err_cam]->client, 
+								THROUGHPUT_LIMIT_REG, 0x43FF);
+						if(!ret_val)
+							break;
+					}
+					else {
+						ret_val = sensor_isp_write(strm_mon[err_cam]->client, 
+								THROUGHPUT_LIMIT_REG, 0x8CA0);
+						if(!ret_val)
+							break;
+					}
+				}
+				if(retry <= 0)
+				{
+					dev_err(&strm_mon[err_cam]->client->dev, 
+							"Error in Writing ThroughtPut Registers");
+				}
+
+				/* Handled Trigger Offset */
+				retry = 5;
+				while(retry > 0)
+				{
+					ret_val = sensor_isp_write(strm_mon[err_cam]->client, 0x1188, 0x00000064);
+					if(!ret_val)
+						break;
+				}
+				if(retry <= 0)
+				{
+					dev_err(&strm_mon[err_cam]->client->dev, 
+							"Error in Writing Trigger Offset Register");
+				}
+			}
+
+			/* Enabling All Camera Links */
+			if(strm_mon[err_cam]->client->adapter->nr == 9)
+			{
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->dser_addr,
+						LINK_REG, dser1_ser_status)) < 0) 
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed \n",
+						__func__, __LINE__);
+				}
+			}
+			else
+			{
+				if((serdes_write_16b_reg(strm_mon[err_cam]->client, 
+					strm_mon[err_cam]->cam->dser_addr,
+						LINK_REG, dser2_ser_status)) < 0) 
+				{
+					dev_err (&strm_mon[err_cam]->client->dev, "%s(%d): Failed \n",
+						__func__, __LINE__);
+				}
+			}
+			reset = 0;
+			econ_frame_err_track = 0;
+			is_err_handle_in_progress = 0;
+			is_isp_sensor_err_handle_in_progress = 0;
+		}
+	}
+
+	pr_info("Streaming Monitor thread is stopped\n");
+	return 0;
+}
+
+uint8_t create_stream_monitor_thread()
+{
+	strm_mon_thrd = kthread_create(stream_monitor_thread,
+				&strm_mon, "strm_mon_thrd");
+	if(strm_mon_thrd == NULL)
+		return -ENOMEM;
+
+	wake_up_process(strm_mon_thrd);
+	is_stream_monitor_thrd = 1;
+	econ_stream_monitor = 1;
+
+	/* Initialize Econ wait queue */
+	if(check_queue_init == 0){
+		init_waitqueue_head(&econ_err_hand_q);
+		pr_info("Initialized E-con wait queue\n");
+		check_queue_init = 1;
+	}
+
+	return ERRCODE_SUCCESS;
+}
+
+uint8_t stop_stream_monitor_thread()
+{
+	pr_info("Going to Stop the thread in STREAM OFF\n");
+	if(is_stream_monitor_thrd == 1) {
+		is_stop_strm_mon_thread = 1;
+		check_queue_init = 0;
+		msleep(1);	       
+		kthread_stop(strm_mon_thrd);
+		pr_info("Streaming Monitor Thread Stopped\n");
+		is_stream_monitor_thrd = 0;
+		econ_stream_monitor = 0;
+	};
+
+	return ERRCODE_SUCCESS;
+}
+
+int create_sysfs_dir(struct i2c_client *client, struct cam *priv)
+{
+	uint8_t loop = 0;
+	
+	/* Creating sysfs entry for econ Error Recovery */
+	if(!is_sysfs_dir){
+		/*Creating a directory in /sys/kernel/ */
+		pr_info("********Creating a directory in /sys/kernel/*********");
+		kobj_ref = kobject_create_and_add("ecam_sysfs",kernel_kobj);
+
+		/*Creating sysfs file for etx_value*/
+		if(sysfs_create_file(kobj_ref,&ecam_status_check_attr.attr)){
+			pr_err("Cannot create sysfs file......\n");
+		}
+		if(sysfs_create_file(kobj_ref,&ecam_cam_num_attr.attr)){
+			pr_err("Cannot create sysfs file......\n");
+		}
+		
+		if(sysfs_create_file(kobj_ref,&ecam_all_cam_attr.attr)){
+			pr_err("Cannot create sysfs file......\n");
+		}
+		is_sysfs_dir = 1;
+	}
+
+	if(!is_strm_mon_mem){
+		for(loop = 0; loop < g_max_cam; loop++){
+			/* Allocate Memory for streaming monitor priv structures */
+			strm_mon[loop] = kzalloc(sizeof(struct econ_stream_monitor),
+				      				GFP_KERNEL);
+			strm_mon[loop]->ecam_state = kzalloc(sizeof(struct econ_cam),
+				     				GFP_KERNEL);
+		}
+        	is_strm_mon_mem = 1;
+	}
+
+	strm_mon[total_num_cam]->client = client;
+	strm_mon[total_num_cam]->cam = priv;
+	priv->cam_order_num = total_num_cam;
+	//num_of_probes++;
+
+	return 0;
+
+}
+
+int remove_sysfs_dir()
+{
+	uint8_t loop = 0;
+
+	if(is_strm_mon_mem == 1){
+		pr_info("Freeing streaming monitor thread memory\n");
+		for(loop = 0; loop < g_max_cam; loop++){
+			kfree(strm_mon[loop]->ecam_state);
+			kfree(strm_mon[loop]);
+		}
+		is_strm_mon_mem = 0;
+		pr_info("Freed streaming monitor thread memory\n");
+
+	}
+	if(is_sysfs_dir){
+		pr_info("Removing ecam Sysfs files\n");
+		kobject_put(kobj_ref); 
+		sysfs_remove_file(kernel_kobj, &ecam_status_check_attr.attr);
+		sysfs_remove_file(kernel_kobj, &ecam_cam_num_attr.attr);
+		is_sysfs_dir = 0;
+		pr_info("Removed ecam Sysfs files\n");
+	}
+
+	return ERRCODE_SUCCESS;
+}
