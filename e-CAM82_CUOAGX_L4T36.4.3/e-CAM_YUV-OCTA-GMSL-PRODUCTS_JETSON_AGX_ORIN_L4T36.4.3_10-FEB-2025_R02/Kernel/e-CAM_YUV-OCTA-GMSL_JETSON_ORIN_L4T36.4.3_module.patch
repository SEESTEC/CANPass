+static int mcu_pwm_remove(struct i2c_client *client)
+{
+	struct device_node *node = client->dev.of_node;
+	int boot_gpio = 0, reset_gpio = 0;
+
+
+	reset_gpio = of_get_named_gpio(node, "reset-mcu", 0);
+	debug_printk("RESET = %x \n",reset_gpio);
+
+	if(reset_gpio < 0) {
+		dev_err(&client->dev, "Unable to toggle GPIO\n");
+		return -EINVAL;
+	}
+	
+	boot_gpio = of_get_named_gpio(node, "boot-mcu", 0);
+	debug_printk("BOOT = %x \n",boot_gpio);
+
+	if(boot_gpio < 0) {
+		dev_err(&client->dev, "Unable to toggle GPIO\n");
+		return -EINVAL;
+	}
+
+	gpio_free(boot_gpio);
+	gpio_free(reset_gpio);
+
+	if(!client){
+		i2c_unregister_device(client);
+	}
+		
+	printk("Device unbound successfully\n");
+
+	return 0;
+}
