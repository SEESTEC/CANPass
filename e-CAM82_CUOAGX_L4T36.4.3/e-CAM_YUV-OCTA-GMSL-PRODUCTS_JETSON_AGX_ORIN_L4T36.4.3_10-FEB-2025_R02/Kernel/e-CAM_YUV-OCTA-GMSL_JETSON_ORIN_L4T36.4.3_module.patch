+int isx031_isp_bootdata_check(struct i2c_client *client, struct cam *priv,
+		uint8_t *spi_flash_bootdata_changed)
+{
+	int errcode = ERRCODE_SUCCESS;
+	unsigned char fw_version[32] = {0}, txt_fw_version[32] = {0};
+	int i=0;
+
+	errcode = spi_get_fw_version(client, fw_version, txt_fw_version);
+	if( errcode != ERRCODE_SUCCESS ){
+		pr_info("Unable to get Boot-Data Version\n");
+	} 
+
+	if(!strcmp(mcu_fw_name_ISP, "ISX031_066F.bin")){
+		
+		pr_info("BOOT-DATA FILE NAME = %s\n",mcu_fw_name_ISP);
+	}
+
+	else if(!strcmp(mcu_fw_name_ISP, "ISX031_054F.bin")){
+		
+		pr_info("BOOT-DATA FILE NAME = %s\n",mcu_fw_name_ISP);		
+	}
+
+	else if(!strcmp(mcu_fw_name_ISP, "ISX031_0128F.bin")){
+			
+		pr_info("BOOT-DATA FILE NAME = %s\n",mcu_fw_name_ISP);		
+	}
+
+	for(i = 0; i < VERSION_SIZE; i++) {
+		if(fw_version[i] != txt_fw_version[i]) {
+			*spi_flash_bootdata_changed = 0x01;
+			break;
+			
+		}
+		else if ( i == 31 ){
+			pr_info("Boot-Data Version Matched - (%.32s)\n",txt_fw_version);
+			*spi_flash_bootdata_changed = 0x00;
+		}
+		
+	}
+
+//	*spi_flash_bootdata_changed = 0x01;		
+	if( *spi_flash_bootdata_changed == 0x01 ){
+
+		pr_info("Previous Boot-Data Version - (%.32s)\n", fw_version);
+		pr_info("Current Boot-Data Version  - (%.32s)\n", txt_fw_version);	
+
+	}
+
+	return errcode;
+}
