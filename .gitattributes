# Tudo da documentação/drivers vive sob doc/<câmera>/ — Git LFS por tipo de arquivo.
# (pacotes de driver e firmware: tar.gz/bin; CAD: stp/dxf). PDFs ficam como blob normal.
doc/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
doc/**/*.bin filter=lfs diff=lfs merge=lfs -text
doc/**/*.stp filter=lfs diff=lfs merge=lfs -text
doc/**/*.dxf filter=lfs diff=lfs merge=lfs -text
