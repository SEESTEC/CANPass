# canpass-field.env — PERFIL DE CAMPO do CANPass.
# Lido pelo serviço systemd no boot (EnvironmentFile) e instalado em
# /usr/local/share/canpass/canpass-field.env pelo install.sh. O serviço roda:
#     watchdog.sh --all   com estas variáveis.
# Formato systemd: KEY=value (SEM 'export', SEM expansão de $ ou %). Valores com
# espaço entre aspas. Editou aqui? Rode 'canpass update' no Orin p/ reinstalar.

# ── Câmeras IP do projeto (somadas à NileCAM81 no modo --all) ───────────────
#   Hikvision 10.105.4.57 → /Streaming/Channels/101 (HEVC) — admin / 'Service@1'
#   Vivotek   10.105.4.51 → /live1s2.sdp (H.264 1920x1080 + áudio pcm_mulaw) — root / 'Service@1'
# Senhas URL-encoded: %40='@', %24='$'. 'Service@1' = Service%401.
CANPASS_IP_URLS="rtsp://admin:Service%401@10.105.4.57:554/Streaming/Channels/101 rtsp://root:Service%401@10.105.4.51:554/live1s2.sdp"
# Republica IP sem reencode (-c copy) p/ poupar CPU. A GRAVAÇÃO funciona mesmo
# assim (o gravador contínuo reencoda em x264); só o WebRTC da Hikvision (HEVC)
# fica preto — para vê-la ao vivo via WebRTC, suba CANPASS_IP_ENCODE=1.
CANPASS_IP_ENCODE=0

# ── Gravação ────────────────────────────────────────────────────────────────
CANPASS_REC_MODE=continuous
CANPASS_REC_EXTERNAL=1
CANPASS_REC_TIMESTAMP=1
CANPASS_TS_POSITION=tl

# ── CAN (J1939 Caterpillar) ─────────────────────────────────────────────────
CANPASS_CAN_BITRATE=250000
CANPASS_CAN_LOG_HUMAN=1
CANPASS_CAN_LOG_ASCII=0

# ── Partida não-interativa (boot de campo, sem operador no monitor) ─────────
CANPASS_NO_INTERVIEW=1
